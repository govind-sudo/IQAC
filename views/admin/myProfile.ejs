<% layout('layout/adminBoilerPlate') %>

<style>
    /* Responsive Profile Layout Styles */
    .profile-page-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px;
    }

    .page-header {
        margin-bottom: 24px;
    }

    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .page-header p {
        color: #64748b;
        font-size: 0.95rem;
    }

    /* Main Grid Layout */
    .profile-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 24px;
        align-items: start;
    }

    /* Cards Common Styling & Hover Effects */
    .profile-card, .details-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .profile-card:hover, .details-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
        border-color: #cbd5e1;
    }

    .profile-card {
        text-align: center;
        padding: 32px 20px;
    }

    .details-card {
        padding: 28px;
    }

    /* User Profile Avatar Hover */
    .avatar-wrapper {
        width: 88px;
        height: 88px;
        background-color: #eff6ff;
        color: #2563eb;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        font-weight: 700;
        margin: 0 auto 16px auto;
        border: 3px solid #dbeafe;
        transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
        cursor: default;
    }

    .profile-card:hover .avatar-wrapper {
        transform: scale(1.08) rotate(3deg);
        background-color: #dbeafe;
        border-color: #93c5fd;
    }

    .user-name {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1e293b;
        word-break: break-word;
    }

    .user-email {
        color: #64748b;
        font-size: 0.875rem;
        margin-bottom: 16px;
        word-break: break-all;
    }

    /* Role Badge Hover */
    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 9999px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .role-badge:hover {
        transform: scale(1.05);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .role-admin {
        background-color: #dbeafe;
        color: #1d4ed8;
    }

    .role-subadmin {
        background-color: #f1f5f9;
        color: #475569;
    }

    .status-divider {
        border-top: 1px solid #f1f5f9;
        padding-top: 16px;
        margin-top: 16px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-pill.active { color: #16a34a; }
    .status-pill.inactive { color: #dc2626; }

    /* Section Headers */
    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title i {
        transition: transform 0.25s ease;
    }

    .details-card:hover .section-title i {
        transform: scale(1.15);
    }

    /* Details Grid & Item Tile Hover */
    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }

    .details-grid.single-section {
        margin-bottom: 0;
    }

    .detail-item {
        background-color: #f8fafc;
        padding: 14px 16px;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
        transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .detail-item:hover {
        background-color: #ffffff;
        border-color: #3b82f6;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
    }

    .detail-label {
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 500;
        display: block;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        transition: color 0.2s ease;
    }

    .detail-item:hover .detail-label {
        color: #2563eb;
    }

    .detail-value {
        font-size: 0.95rem;
        color: #0f172a;
        font-weight: 600;
        word-break: break-word;
    }

    /* Media Queries */
    @media (max-width: 992px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }

        .profile-card {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .status-divider {
            width: 100%;
        }
    }

    @media (max-width: 640px) {
        .profile-page-container {
            padding: 12px;
        }

        .details-card {
            padding: 20px 16px;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 24px;
        }

        .page-header h1 {
            font-size: 1.4rem;
        }

        .page-header p {
            font-size: 0.875rem;
        }

        .section-title {
            font-size: 1rem;
        }

        .detail-item {
            padding: 12px;
        }
    }
</style>

<div class="profile-page-container">
    <%- include('../partials/flash') %>

    <!-- Header Section -->
    <header class="page-header">
        <p>View your administrative profile details and system access information.</p>
    </header>

    <div class="profile-grid">
        
        <!-- Summary Card -->
        <div class="profile-card">
            <div class="avatar-wrapper">
                <%= admin.fullName ? admin.fullName.charAt(0).toUpperCase() : 'U' %>
            </div>

            <h2 class="user-name"><%= admin.fullName %></h2>
            <p class="user-email"><%= admin.email %></p>

            <div class="role-badge-container">
                <span class="role-badge <%= admin.role === 'admin' ? 'role-admin' : 'role-subadmin' %>">
                    <i class="fa-solid <%= admin.role === 'admin' ? 'fa-shield-halved' : 'fa-user-gear' %>"></i>
                    <%= admin.role %>
                </span>
            </div>

            <div class="status-divider">
                <span class="status-pill <%= admin.isActive ? 'active' : 'inactive' %>">
                    <i class="fa-solid fa-circle" style="font-size: 8px;"></i>
                    <%= admin.isActive ? 'ACCOUNT ACTIVE' : 'ACCOUNT INACTIVE' %>
                </span>
            </div>
        </div>

        <!-- Details Display Card -->
        <div class="details-card">
            
            <!-- Personal Information Section -->
            <h3 class="section-title">
                <i class="fa-solid fa-address-card" style="color: #2563eb;"></i> Personal Information
            </h3>

            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Full Name</span>
                    <div class="detail-value"><%= admin.fullName %></div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">MIS Code</span>
                    <div class="detail-value" style="text-transform: uppercase;"><%= admin.misCode %></div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Email Address</span>
                    <div class="detail-value"><%= admin.email %></div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Phone Number</span>
                    <div class="detail-value"><%= admin.phone || 'Not Provided' %></div>
                </div>
            </div>

            <!-- System Information Section -->
            <h3 class="section-title">
                <i class="fa-solid fa-shield-halved" style="color: #2563eb;"></i> System Information
            </h3>

            <div class="details-grid single-section">
                <div class="detail-item">
                    <span class="detail-label">Assigned Role</span>
                    <div class="detail-value" style="text-transform: capitalize;"><%= admin.role %></div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Account Created</span>
                    <div class="detail-value">
                        <%= new Date(admin.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Created By</span>
                    <div class="detail-value">
                        <%= admin.createdBy ? (admin.createdBy.fullName + ' (' + admin.createdBy.email + ')') : 'System / Root Admin' %>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>