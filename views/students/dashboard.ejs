<% layout("layout/studentsBoilerPlate") %>
<%
	// `student` is the Mongoose Student document passed from the route
	// (e.g. res.render("students/dashboard", { student, ... })).
	// Guarded with a differently-named local so a missing `student` doesn't
	// crash the page - but no fields are ever faked here, only left blank.
	const studentInfo = (typeof student !== 'undefined' && student) ? student : {};

	// ---- Derived display values (all read straight from studentInfo) ----
	const studentName = studentInfo.fullName
		|| [studentInfo.firstName, studentInfo.lastName].filter(Boolean).join(' ')
		|| 'Student';

	const studentInitials = studentName
		.split(' ')
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part.charAt(0))
		.join('')
		.toUpperCase() || 'S';

	// No photo field exists on the Student schema yet - this stays ready
	// for whenever one is added (e.g. studentInfo.profilePhoto).
	const studentPhoto = studentInfo.profilePhoto || studentInfo.photoUrl || null;

	const studentDepartment = studentInfo.department || studentInfo.program || studentInfo.course || 'Not set';

	// ---- Profile completion, computed from actual schema fields ----
	// Grouped to match the section labels shown in the progress list below.
	// profileStatus-based "Documents" score is a placeholder proxy until a
	// real Documents collection exists.
	function sectionPercent(fields) {
		if (!fields.length) return 0;
		const filled = fields.filter((v) => v !== undefined && v !== null && v !== '').length;
		return Math.round((filled / fields.length) * 100);
	}

	const personalInfoPercent = sectionPercent([
		studentInfo.title, studentInfo.firstName, studentInfo.lastName,
		studentInfo.gender, studentInfo.dob, studentInfo.bloodGroup,
		studentInfo.category, studentInfo.religion, studentInfo.caste,
	]);

	const academicInfoPercent = sectionPercent([
		studentInfo.institute, studentInfo.course, studentInfo.program,
		studentInfo.department, studentInfo.admissionYear,
		studentInfo.admissionType, studentInfo.admissionQuota, studentInfo.enrollmentNo,
	]);

	const contactInfoPercent = sectionPercent([
		studentInfo.phone, studentInfo.whatsapp, studentInfo.alternateEmail,
		studentInfo.presentAddress && studentInfo.presentAddress.city,
		studentInfo.permanentAddress && studentInfo.permanentAddress.city,
	]);

	const additionalInfoPercent = sectionPercent([
		studentInfo.father && studentInfo.father.name,
		studentInfo.mother && studentInfo.mother.name,
		studentInfo.emergencyContact && studentInfo.emergencyContact.name,
		studentInfo.emergencyContact && studentInfo.emergencyContact.phone,
		studentInfo.aadhaarNumber,
	]);

	const documentsPercentMap = { verified: 100, pending: 50, rejected: 25, incomplete: 0 };
	const documentsPercent = documentsPercentMap[studentInfo.profileStatus] ?? 0;

	const normalizedProfileItems = [
		{ label: 'Personal Info', value: personalInfoPercent },
		{ label: 'Academic Info', value: academicInfoPercent },
		{ label: 'Contact Info', value: contactInfoPercent },
		{ label: 'Additional Info', value: additionalInfoPercent },
		{ label: 'Documents', value: documentsPercent },
	];

	const profilePercent = Math.round(
		normalizedProfileItems.reduce((sum, item) => sum + item.value, 0) / normalizedProfileItems.length
	);

	const totalFields = 30; // personal(9) + academic(8) + contact(5) + additional(5) + documents(1, via profileStatus... kept coarse on purpose
	const completedFields = Math.round((profilePercent / 100) * totalFields);

	// ---- Everything below this line is NOT part of the Student model yet ----
	// (forms, deadlines, messages/notifications, quick actions). These need
	// their own collections/routes; until then they come through as optional
	// locals from the controller, and render an empty state if absent -
	// nothing here is invented/faked.
	const stats = typeof dashboardStats !== 'undefined' ? dashboardStats : {};
	const deadlineItems = typeof upcomingDeadlines !== 'undefined' && Array.isArray(upcomingDeadlines) ? upcomingDeadlines : [];
	const notificationItems = typeof notificationsData !== 'undefined' && Array.isArray(notificationsData) ? notificationsData : [];

	// Quick Actions are static in-app navigation shortcuts, not student data,
	// so these stay fixed rather than coming from an API.
	const actionItems = [
		{ href: '/students/profile', icon: 'fa-user-pen', title: 'Update Profile', text: 'Edit personal and academic details' },
		{ href: '/students/documents', icon: 'fa-folder-open', title: 'View Documents', text: 'Check uploaded files and records' },
		{ href: '/students/messages', icon: 'fa-message', title: 'Send Message', text: 'Contact faculty or admin' },
		{ href: '/students/notices', icon: 'fa-calendar-check', title: 'Check Deadlines', text: 'Review the latest submission dates' },
	];

	const statCards = [
		{ label: 'Profile Completion', value: profilePercent + '%', tone: 'green', icon: 'fa-user-check', note: profilePercent >= 100 ? 'All set!' : 'Keep going!' },
		{ label: 'Forms Completed', value: stats.formsCompleted ?? '—', tone: 'blue', icon: 'fa-file-lines', note: 'View all forms' },
		{ label: 'Pending Forms', value: stats.pendingForms ?? '—', tone: 'orange', icon: 'fa-file-circle-exclamation', note: 'Complete now' },
		{ label: 'Messages', value: stats.messages ?? '—', tone: 'purple', icon: 'fa-envelope', note: 'New replies' },
	];
%>

<section class="student-dashboard">
	<header class="dashboard-hero">
		<div class="hero-copy">
			<p class="eyebrow">Student Dashboard</p>
			<h1>Welcome back, <span><%= studentName %></span>!</h1>
			<p class="hero-subtitle">Here's a quick look at your profile status, pending work, and upcoming deadlines.</p>
		</div>

		<div class="hero-meta">
			<div class="meta-card meta-card-profile">
				<div class="student-avatar">
					<% if (studentPhoto) { %>
						<img src="<%= studentPhoto %>" alt="<%= studentName %> profile photo" />
					<% } else { %>
						<span><%= studentInitials %></span>
					<% } %>
				</div>
				<div class="student-meta-text">
					<span class="meta-label">Signed in as</span>
					<strong><%= studentName %></strong>
					<small><%= studentDepartment %></small>
				</div>
			</div>
			<a class="meta-card meta-card-icon meta-card-message" href="/students/messages" aria-label="Open messages">
				<i class="fa-solid fa-message"></i>
				<span>Messages</span>
			</a>
			<div class="meta-card meta-card-icon meta-card-bell">
				<button type="button" class="bell-toggle" aria-label="Show notifications" aria-expanded="false">
					<i class="fa-regular fa-bell"></i>
					<% if (notificationItems.length) { %>
						<span class="bell-badge"><%= notificationItems.length %></span>
					<% } %>
				</button>
				<div class="notification-popover" hidden>
					<div class="notification-popover__head">
						<strong>Notifications</strong>
						<a href="/students/messages">View messages</a>
					</div>
					<div class="notification-popover__list">
						<% if (notificationItems.length) { %>
							<% notificationItems.forEach((notification) => { %>
								<div class="notification-item notification-<%= notification.tone || 'blue' %>">
									<span class="notification-item__icon"><i class="fa-solid <%= notification.icon %>"></i></span>
									<div>
										<p><%= notification.title %></p>
										<small><%= notification.meta %></small>
									</div>
								</div>
							<% }) %>
						<% } else { %>
							<div class="notification-item">
								<div><p>You're all caught up. No new notifications.</p></div>
							</div>
						<% } %>
					</div>
				</div>
			</div>
		</div>
	</header>

	<section class="stats-grid" aria-label="Dashboard summary">
		<% statCards.forEach((stat) => { %>
			<article class="stat-card stat-<%= stat.tone %>">
				<div class="stat-icon"><i class="fa-solid <%= stat.icon %>"></i></div>
				<div class="stat-content">
					<span><%= stat.label %></span>
					<strong><%= stat.value %></strong>
					<small><%= stat.note %></small>
				</div>
			</article>
		<% }) %>
	</section>

	<section class="dashboard-grid">
		<article class="card profile-card">
			<div class="card-heading">
				<div>
					<p class="card-kicker">Profile Completion</p>
					<h2>Profile Completion</h2>
				</div>
				<a href="/students/profile">Update Profile</a>
			</div>

			<div class="profile-wrap">
				<div class="progress-ring" style="<%= '--progress: ' + profilePercent + ';' %>">
					<div class="progress-ring__inner">
						<strong><%= profilePercent %>%</strong>
						<span>Complete</span>
					</div>
				</div>

				<div class="progress-list">
					<p class="profile-note">You have completed <%= completedFields %> of <%= totalFields %> fields.</p>
					<% normalizedProfileItems.forEach((item) => { %>
						<div class="progress-item">
							<div class="progress-item__top">
								<span><%= item.label %></span>
								<strong><%= item.value %>%</strong>
							</div>
							<div class="progress-bar"><span style="<%= 'width: ' + item.value + '%;' %>"></span></div>
						</div>
					<% }) %>
				</div>
			</div>
		</article>

		<article class="card deadline-card">
			<div class="card-heading">
				<div>
					<p class="card-kicker">Upcoming Deadlines</p>
					<h2>Keep track of what's next</h2>
				</div>
				<a href="/students/notices">View All</a>
			</div>

			<div class="deadline-list">
				<% if (deadlineItems.length) { %>
					<% deadlineItems.forEach((deadline) => { %>
						<div class="deadline-item <%= deadline.urgent ? 'urgent' : '' %>">
							<div class="deadline-date">
								<strong><%= deadline.day %></strong>
								<span><%= deadline.month %></span>
							</div>
							<div class="deadline-copy">
								<h3><%= deadline.title %></h3>
								<p><%= deadline.description %></p>
							</div>
							<div class="deadline-flag"><%= deadline.left %></div>
						</div>
					<% }) %>
				<% } else { %>
					<p class="profile-note">No upcoming deadlines right now.</p>
				<% } %>
			</div>
		</article>
	</section>

	<section class="card actions-card">
		<div class="card-heading">
			<div>
				<p class="card-kicker">Quick Actions</p>
				<h2>Shortcuts for common tasks</h2>
			</div>
		</div>

		<div class="actions-grid">
			<% actionItems.forEach((action) => { %>
				<a class="action-card" href="<%= action.href %>">
					<span class="action-icon"><i class="fa-solid <%= action.icon %>"></i></span>
					<strong><%= action.title %></strong>
					<p><%= action.text %></p>
				</a>
			<% }) %>
		</div>
	</section>

	<script>
		(function () {
			const bellCard = document.querySelector('.meta-card-bell');
			if (!bellCard) return;

			const button = bellCard.querySelector('.bell-toggle');
			const popover = bellCard.querySelector('.notification-popover');

			const closePopover = () => {
				bellCard.classList.remove('is-open');
				button.setAttribute('aria-expanded', 'false');
				popover.hidden = true;
			};

			button.addEventListener('click', function (event) {
				event.stopPropagation();
				const isOpen = bellCard.classList.toggle('is-open');
				button.setAttribute('aria-expanded', String(isOpen));
				popover.hidden = !isOpen;
			});

			document.addEventListener('click', function (event) {
				if (!bellCard.contains(event.target)) {
					closePopover();
				}
			});
		})();
	</script>
</section>