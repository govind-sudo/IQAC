                    </a>
                </li>

                <li class="<%= currentPage === 'academic' ? 'active' : '' %>">
                    <a href="/students/academic">
                        <i class="fa-regular fa-building"></i>
                        <span>Academic Details</span>
                    </a>
                </li>

                <li class="<%= currentPage === 'documents' ? 'active' : '' %>">
                    <a href="/students/documents">
                        <i class="fa-regular fa-folder-open"></i>
                        <span>Documents</span>
                    </a>
                </li>

                <li class="<%= currentPage === 'addresses' ? 'active' : '' %>">
                    <a href="/students/addresses">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>My Addresses</span>
                    </a>
                </li>

                <li class="<%= currentPage === 'contact' ? 'active' : '' %>">
                    <a href="/students/contact">
