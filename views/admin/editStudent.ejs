<% layout('layout/adminBoilerPlate') %>

<link rel="stylesheet" href="/css/admin/editStudent.css">

<style>
    .form-page-container .btn-primary:disabled {
        background: #c7d2fe;
        cursor: not-allowed;
    }
    .form-page-container .btn-primary:disabled:hover {
        background: #c7d2fe;
    }
    .form-page-container .unsaved-hint {
        align-self: center;
        margin-right: auto;
        font-size: 13px;
        color: #6b7280;
    }
</style>

<%
// ---------------------------------------------------------------
// Reconstruct the exact state the student registered in.
// Everything below is derived from stored data — nothing defaults
// to "Indian / dropdown mode" unless the data actually says so.
// ---------------------------------------------------------------
const nationalityRaw = (student.nationality || 'Indian').trim();
const isIndian       = nationalityRaw.toLowerCase() === 'indian';

const category       = student.category || 'General';
const isPWD          = isIndian && category === 'PWD';
const isCasteCategory= isIndian && category !== 'General' && category !== 'PWD';

// Which qualification did the student actually fill in?
// Check a real field, not the subdoc — Mongoose can materialise an
// empty {} which is truthy and would mis-detect "diploma".
const hasDiploma = !!(student.education?.diploma?.schoolName
                   || student.education?.diploma?.percentage
                   || student.education?.diploma?.marksheet);
const qualKey    = hasDiploma ? 'diploma' : 'twelfth';
const qual       = student.education?.[qualKey] || {};

// Address mode is per-side and comes from the saved country.
const presCountry   = student.presentAddress?.country   || 'India';
const permCountry   = student.permanentAddress?.country || 'India';
const presIsIndia   = presCountry === 'India';
const permIsIndia   = permCountry === 'India';

const docUrl = (p) => `/admin/students/${student._id}/documents/file?path=${encodeURIComponent(p)}`;
%>

<div class="form-page-container">
    <div class="form-header">
        <a href="/admin/students/<%= student._id %>/inDetail" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to Student Profile
        </a>
        <h1>Edit Student — <%= student.fullName || (student.firstName + ' ' + student.lastName) %></h1>
        <p>Update this student's information and documents.</p>
    </div>

    <div class="card form-card">
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert-popup error">
                <div class="alert-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
                <div class="alert-content">
                    <strong>Update Failed</strong>
                    <p><%= errorMessage %></p>
                </div>
                <button type="button" class="close-alert-btn" onclick="this.parentElement.remove();">&times;</button>
            </div>
        <% } %>

        <form id="editStudentForm" action="/admin/students/<%= student._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="subadmin-form">

            <!-- ==================== BASIC INFORMATION ==================== -->
            <h3 class="section-title">Basic Information</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Title</label>
                    <select name="title" id="editTitle" data-current="<%= student.title || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>First Name</label>
                    <input type="text" name="firstName" value="<%= student.firstName || '' %>" required />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Middle Name</label>
                    <input type="text" name="middleName" value="<%= student.middleName || '' %>" />
                </div>
                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text" name="lastName" value="<%= student.lastName || '' %>" required />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Gender</label>
                    <select name="gender" id="editGender" data-current="<%= student.gender || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Date of Birth</label>
                    <input type="date" name="dob" value="<%= student.dob ? new Date(student.dob).toISOString().split('T')[0] : '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Blood Group</label>
                    <select name="bloodGroup" id="editBloodGroup" data-current="<%= student.bloodGroup || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Religion / Belief</label>
                    <input type="text" name="religion" value="<%= student.religion || '' %>" placeholder="e.g. Hinduism, Islam, Christianity" />
                </div>
            </div>

            <!-- Nationality: select drives the mode, the text input carries the
                 real stored value ("Nigerian"), exactly like the register form. -->
            <div class="form-row">
                <div class="form-group">
                    <label>Nationality</label>
                    <select id="editNationalityType">
                        <option value="Indian" <%= isIndian ? 'selected' : '' %>>Indian</option>
                        <option value="Other"  <%= !isIndian ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div class="form-group" id="editNationalityField" style="<%= isIndian ? 'display:none;' : '' %>">
                    <label>Enter Nationality</label>
                    <input type="text" name="nationality" id="editNationality"
                           value="<%= isIndian ? 'Indian' : nationalityRaw %>"
                           placeholder="Enter Nationality" />
                </div>
            </div>

            <div id="indianOnlyFields" style="<%= isIndian ? '' : 'display:none;' %>">
                <div class="form-row">
                    <div class="form-group">
                        <label>Category</label>
                        <select name="category" id="editCategory" data-current="<%= category %>"></select>
                    </div>
                    <div class="form-group">
                        <label>Caste</label>
                        <input type="text" name="caste" value="<%= student.caste || '' %>" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Aadhaar Number</label>
                        <input type="text" name="aadhaarNumber" value="<%= student.aadhaarNumber || '' %>"
                               maxlength="12" inputmode="numeric" pattern="[0-9]{12}" />
                    </div>
                    <div class="form-group">
                        <label>ABC ID / APAAR ID</label>
                        <input type="text" name="abcId" value="<%= student.abcId || '' %>" maxlength="12" />
                    </div>
                </div>
            </div>

            <div id="internationalOnlyFields" style="<%= !isIndian ? '' : 'display:none;' %>">
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Passport Number</label>
                        <input type="text" name="passportNumber" value="<%= student.passportNumber || '' %>" />
                    </div>
                </div>
            </div>

            <!-- ==================== CONTACT ==================== -->
            <h3 class="section-title" style="margin-top:24px;">Contact</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" value="<%= student.email || '' %>" required />
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <div class="phone-group">
                        <select name="phoneCode" id="studentPhoneCode" data-current="<%= student.phoneCode || '+91' %>"></select>
                        <input type="tel" name="phone" value="<%= student.phone || '' %>" />
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>WhatsApp</label>
                    <input type="tel" name="whatsapp" value="<%= student.whatsapp || '' %>" />
                </div>
                <div class="form-group">
                    <label>Alternate Email</label>
                    <input type="email" name="alternateEmail" value="<%= student.alternateEmail || '' %>" />
                </div>
            </div>

            <!-- ==================== PRESENT ADDRESS ==================== -->
            <h3 class="section-title" style="margin-top:24px;">Present Address</h3>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Address Line 1</label>
                    <input type="text" name="presentAddress[address1]" value="<%= student.presentAddress?.address1 || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Address Line 2</label>
                    <input type="text" name="presentAddress[address2]" value="<%= student.presentAddress?.address2 || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Country</label>
                    <select id="presentCountry" <%= presIsIndia ? 'name="presentAddress[country]"' : '' %>>
                        <option value="India" <%= presIsIndia ? 'selected' : '' %>>India</option>
                        <option value="Other" <%= !presIsIndia ? 'selected' : '' %>>Other</option>
                    </select>
                    <input type="text" id="presentCountryText"
                           <%= !presIsIndia ? 'name="presentAddress[country]"' : '' %>
                           value="<%= presIsIndia ? '' : presCountry %>"
                           placeholder="Country Name"
                           style="<%= presIsIndia ? 'display:none;' : 'margin-top:8px;' %>" />
                </div>
                <div class="form-group">
                    <label>State / Province</label>
                    <select id="presentState"
                            <%= presIsIndia ? 'name="presentAddress[state]" required' : '' %>
                            data-current="<%= student.presentAddress?.state || '' %>"
                            style="<%= presIsIndia ? '' : 'display:none;' %>"></select>
                    <input type="text" id="presentStateText"
                           <%= !presIsIndia ? 'name="presentAddress[state]" required' : '' %>
                           value="<%= presIsIndia ? '' : (student.presentAddress?.state || '') %>"
                           placeholder="State / Province"
                           style="<%= presIsIndia ? 'display:none;' : '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>District</label>
                    <select id="presentDistrict"
                            <%= presIsIndia ? 'name="presentAddress[district]" required' : '' %>
                            data-current="<%= student.presentAddress?.district || '' %>"
                            style="<%= presIsIndia ? '' : 'display:none;' %>"></select>
                    <input type="text" id="presentDistrictText"
                           <%= !presIsIndia ? 'name="presentAddress[district]" required' : '' %>
                           value="<%= presIsIndia ? '' : (student.presentAddress?.district || '') %>"
                           placeholder="District / County"
                           style="<%= presIsIndia ? 'display:none;' : '' %>" />
                </div>
                <div class="form-group">
                    <label>City</label>
                    <input type="text" name="presentAddress[city]" value="<%= student.presentAddress?.city || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Pincode</label>
                    <input type="text" name="presentAddress[pincode]" value="<%= student.presentAddress?.pincode || '' %>" />
                </div>
            </div>

            <!-- ==================== PERMANENT ADDRESS ==================== -->
            <h3 class="section-title" style="margin-top:24px;">Permanent Address</h3>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Address Line 1</label>
                    <input type="text" name="permanentAddress[address1]" value="<%= student.permanentAddress?.address1 || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Address Line 2</label>
                    <input type="text" name="permanentAddress[address2]" value="<%= student.permanentAddress?.address2 || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Country</label>
                    <select id="permanentCountry" <%= permIsIndia ? 'name="permanentAddress[country]"' : '' %>>
                        <option value="India" <%= permIsIndia ? 'selected' : '' %>>India</option>
                        <option value="Other" <%= !permIsIndia ? 'selected' : '' %>>Other</option>
                    </select>
                    <input type="text" id="permanentCountryText"
                           <%= !permIsIndia ? 'name="permanentAddress[country]"' : '' %>
                           value="<%= permIsIndia ? '' : permCountry %>"
                           placeholder="Country Name"
                           style="<%= permIsIndia ? 'display:none;' : 'margin-top:8px;' %>" />
                </div>
                <div class="form-group">
                    <label>State / Province</label>
                    <select id="permanentState"
                            <%= permIsIndia ? 'name="permanentAddress[state]" required' : '' %>
                            data-current="<%= student.permanentAddress?.state || '' %>"
                            style="<%= permIsIndia ? '' : 'display:none;' %>"></select>
                    <input type="text" id="permanentStateText"
                           <%= !permIsIndia ? 'name="permanentAddress[state]" required' : '' %>
                           value="<%= permIsIndia ? '' : (student.permanentAddress?.state || '') %>"
                           placeholder="State / Province"
                           style="<%= permIsIndia ? 'display:none;' : '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>District</label>
                    <select id="permanentDistrict"
                            <%= permIsIndia ? 'name="permanentAddress[district]" required' : '' %>
                            data-current="<%= student.permanentAddress?.district || '' %>"
                            style="<%= permIsIndia ? '' : 'display:none;' %>"></select>
                    <input type="text" id="permanentDistrictText"
                           <%= !permIsIndia ? 'name="permanentAddress[district]" required' : '' %>
                           value="<%= permIsIndia ? '' : (student.permanentAddress?.district || '') %>"
                           placeholder="District / County"
                           style="<%= permIsIndia ? 'display:none;' : '' %>" />
                </div>
                <div class="form-group">
                    <label>City</label>
                    <input type="text" name="permanentAddress[city]" value="<%= student.permanentAddress?.city || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Pincode</label>
                    <input type="text" name="permanentAddress[pincode]" value="<%= student.permanentAddress?.pincode || '' %>" />
                </div>
            </div>

            <!-- ==================== PARENT / GUARDIAN ==================== -->
            <h3 class="section-title" style="margin-top:24px;">Parent / Guardian</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Father's Name</label>
                    <input type="text" name="father[name]" value="<%= student.father?.name || '' %>" />
                </div>
                <div class="form-group">
                    <label>Father's Phone</label>
                    <div class="phone-group">
                        <select name="father[phoneCode]" id="fatherPhoneCode" data-current="<%= student.father?.phoneCode || '+91' %>"></select>
                        <input type="tel" name="father[phone]" value="<%= student.father?.phone || '' %>" />
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Father's Email</label>
                    <input type="email" name="father[email]" value="<%= student.father?.email || '' %>" />
                </div>
                <div class="form-group">
                    <label>Mother's Name</label>
                    <input type="text" name="mother[name]" value="<%= student.mother?.name || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Mother's Phone</label>
                    <div class="phone-group">
                        <select name="mother[phoneCode]" id="motherPhoneCode" data-current="<%= student.mother?.phoneCode || '+91' %>"></select>
                        <input type="tel" name="mother[phone]" value="<%= student.mother?.phone || '' %>" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Mother's Email</label>
                    <input type="email" name="mother[email]" value="<%= student.mother?.email || '' %>" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Emergency Contact Name</label>
                    <input type="text" name="emergencyContact[name]" value="<%= student.emergencyContact?.name || '' %>" />
                </div>
                <div class="form-group">
                    <label>Emergency Contact Phone</label>
                    <div class="phone-group">
                        <select name="emergencyContact[phoneCode]" id="emergencyPhoneCode" data-current="<%= student.emergencyContact?.phoneCode || '+91' %>"></select>
                        <input type="tel" name="emergencyContact[phone]" value="<%= student.emergencyContact?.phone || '' %>" />
                    </div>
                </div>
            </div>

            <!-- ==================== ACADEMIC ==================== -->
            <h3 class="section-title" style="margin-top:24px;">Academic</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>UG Number</label>
                    <input type="text" name="ugNumber" value="<%= student.ugNumber || '' %>" required />
                </div>
                <div class="form-group">
                    <label>Enrollment Number</label>
                    <input type="text" name="enrollmentNo" value="<%= student.enrollmentNo || '' %>" placeholder="Assigned by Admin" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Faculty</label>
                    <select id="editFaculty" name="faculty" data-current="<%= student.faculty || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Institute</label>
                    <select id="editInstitute" name="institute" data-current="<%= student.institute || '' %>"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Course</label>
                    <select id="editCourse" name="course" data-current="<%= student.course || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Branch</label>
                    <select id="editBranch" name="branch" data-current="<%= student.branch || '' %>"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Specialization</label>
                    <select id="editSpecialization" name="specialization" data-current="<%= student.specialization || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Admission Type</label>
                    <select name="admissionType" id="editAdmissionType" data-current="<%= student.admissionType || '' %>"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Campus Reporting Date</label>
                    <input type="date" name="joiningDate" value="<%= student.joiningDate ? new Date(student.joiningDate).toISOString().split('T')[0] : '' %>" />
                </div>
                <div class="form-group">
                    <label>Student Status</label>
                    <select name="studentStatus" id="editStudentStatus" data-current="<%= student.studentStatus || '' %>"></select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Profile Status</label>
                    <select name="profileStatus" id="editProfileStatus" data-current="<%= student.profileStatus || '' %>"></select>
                </div>
                <div class="form-group">
                    <label>Resides in PU Hostel?</label>
                    <select name="residesInHostel" id="editResidesInHostel">
                        <option value="true"  <%= student.residesInHostel ? 'selected' : '' %>>Yes</option>
                        <option value="false" <%= !student.residesInHostel ? 'selected' : '' %>>No</option>
                    </select>
                </div>
            </div>
            <div class="form-row" id="editHostelNameField" style="<%= student.residesInHostel ? '' : 'display:none;' %>">
                <div class="form-group full-width">
                    <label>Full Name of PU Hostel</label>
                    <select name="hostelName" id="editHostelName" data-current="<%= student.hostelName || '' %>"></select>
                </div>
            </div>

            <!-- ==================== INDIAN: EDUCATION + DOCUMENTS ==================== -->
            <div id="indianEducationDocs" style="<%= isIndian ? '' : 'display:none;' %>">

                <h3 class="section-title" style="margin-top:24px;">10th Standard</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label>School Name</label>
                        <input type="text" name="education[tenth][schoolName]" value="<%= student.education?.tenth?.schoolName || '' %>" />
                    </div>
                    <div class="form-group">
                        <label>Percentage (%)</label>
                        <input type="number" step="0.01" min="0" max="100" name="education[tenth][percentage]"
                               value="<%= student.education?.tenth?.percentage ?? '' %>" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Replace 10th Marksheet (leave blank to keep existing)</label>
                        <input type="file" name="education[tenth][marksheet]" accept="application/pdf,image/*" />
                        <% if (student.education?.tenth?.marksheet) { %>
                            <small>Current: <a href="<%= docUrl(student.education.tenth.marksheet) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>

                <h3 class="section-title" style="margin-top:24px;">12th Standard / Diploma</h3>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Qualification</label>
                        <select id="editQualificationType" name="qualificationType">
                            <option value="twelfth" <%= qualKey === 'twelfth' ? 'selected' : '' %>>12th Standard</option>
                            <option value="diploma" <%= qualKey === 'diploma' ? 'selected' : '' %>>Diploma</option>
                        </select>
                        <small>Switching this moves the details below to the other qualification and clears the unused one.</small>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label id="editQualSchoolLabel"><%= qualKey === 'diploma' ? 'Diploma Institute Name' : 'School / College Name' %></label>
                        <input type="text" id="editQualSchool" name="education[<%= qualKey %>][schoolName]" value="<%= qual.schoolName || '' %>" />
                    </div>
                    <div class="form-group">
                        <label>Percentage (%)</label>
                        <input type="number" step="0.01" min="0" max="100" id="editQualPercentage"
                               name="education[<%= qualKey %>][percentage]" value="<%= qual.percentage ?? '' %>" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label id="editQualMarksheetLabel">Replace <%= qualKey === 'diploma' ? 'Diploma' : '12th' %> Marksheet (leave blank to keep existing)</label>
                        <input type="file" id="editQualMarksheet" name="education[<%= qualKey %>][marksheet]" accept="application/pdf,image/*" />
                        <% if (qual.marksheet) { %>
                            <small>Current: <a href="<%= docUrl(qual.marksheet) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>

                <h3 class="section-title" style="margin-top:24px;">Documents</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label>Aadhaar Proof</label>
                        <input type="file" name="documents[aadhaarProof]" accept="application/pdf,image/*" />
                        <% if (student.documents?.aadhaarProof) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.aadhaarProof) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label>ABC ID / APAAR ID Proof</label>
                        <input type="file" name="documents[abcIdProof]" accept="application/pdf,image/*" />
                        <% if (student.documents?.abcIdProof) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.abcIdProof) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Leaving Certificate</label>
                        <input type="file" name="documents[leavingCertificate]" accept="application/pdf,image/*" />
                        <% if (student.documents?.leavingCertificate) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.leavingCertificate) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>

                <div class="form-row" id="editCasteProofRow" style="<%= isCasteCategory ? '' : 'display:none;' %>">
                    <div class="form-group full-width">
                        <label>Caste Certificate</label>
                        <input type="file" name="documents[casteProof]" accept="application/pdf,image/*" />
                        <% if (student.documents?.casteProof) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.casteProof) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>

                <div class="form-row" id="editPwdProofRow" style="<%= isPWD ? '' : 'display:none;' %>">
                    <div class="form-group full-width">
                        <label>PWD Certificate</label>
                        <input type="file" name="documents[pwdProof]" accept="application/pdf,image/*" />
                        <% if (student.documents?.pwdProof) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.pwdProof) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ==================== INTERNATIONAL: 3 DOCUMENTS ONLY ==================== -->
            <div id="internationalDocs" style="<%= !isIndian ? '' : 'display:none;' %>">
                <h3 class="section-title" style="margin-top:24px;">International Documents</h3>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Passport</label>
                        <input type="file" name="documents[passportUpload]" accept="application/pdf,image/*" />
                        <% if (student.documents?.passportUpload) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.passportUpload) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>A/O Level Certificate</label>
                        <input type="file" name="documents[aoLevelCertificate]" accept="application/pdf,image/*" />
                        <% if (student.documents?.aoLevelCertificate) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.aoLevelCertificate) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>PU Admission Letter</label>
                        <input type="file" name="documents[puAdmissionLetter]" accept="application/pdf,image/*" />
                        <% if (student.documents?.puAdmissionLetter) { %>
                            <small>Current: <a href="<%= docUrl(student.documents.puAdmissionLetter) %>" target="_blank" rel="noopener">View Document</a></small>
                        <% } else { %>
                            <small class="no-doc">No Document</small>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <span class="unsaved-hint" id="unsavedHint">No changes yet</span>
                <a href="/admin/students/<%= student._id %>/inDetail" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary" id="saveChangesBtn">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    'use strict';

    /* =========================================================
       Option lists — values match the Student schema enums
       exactly (lowercase gender/status, etc). Kept inline so
       this page has no external JS dependency.
       ========================================================= */
    const OPTIONS = {
        title:          [['Mr','Mr.'], ['Ms','Ms.'], ['Mrs','Mrs.']],
        gender:         [['male','Male'], ['female','Female'], ['other','Other']],
        bloodGroup:     [['A+','A+'],['A-','A-'],['B+','B+'],['B-','B-'],['AB+','AB+'],['AB-','AB-'],['O+','O+'],['O-','O-']],
        category:       [['General','General'],['OBC','OBC'],['SC','SC'],['ST','ST'],['EWS','EWS'],['PWD','PWD']],
        admissionType:  [['Regular','Regular'],['Lateral Entry','Lateral Entry'],['Transfer','Transfer']],
        studentStatus:  [['active','Active'],['graduated','Graduated'],['dropped','Dropped'],['suspended','Suspended']],
        profileStatus:  [['incomplete','Incomplete'],['pending','Pending'],['verified','Verified'],['rejected','Rejected']],
    };

    const FACULTY_OPTIONS = [['FET', 'Faculty of Engineering and Technology (FET)']];
    const INSTITUTE_OPTIONS = {
        FET: [['Parul Institute of Engineering and Technology', 'Parul Institute of Engineering and Technology (PIET)']],
    };
    const COURSE_OPTIONS = {
        'Parul Institute of Engineering and Technology': [['Bachelor of Technology', 'Bachelor of Technology (B.Tech.)']],
    };
    const BRANCH_OPTIONS = {
        'Bachelor of Technology': [['CSE', 'Computer Science and Engineering (CSE)']],
    };
    const SPECIALIZATION_OPTIONS = {
        CSE: [
            ['AIML', 'Artificial Intelligence and Machine Learning (AIML)'],
            ['AIRO', 'Artificial Intelligence and Robotics (AIRO)'],
        ],
    };

   const HOSTEL_GROUPS = {
    'SHASTRI BHAWAN': [
        'SHASTRI BHAWAN - A',
        'SHASTRI BHAWAN - B',
        'SHASTRI BHAWAN - C'
    ],

    'KALAM BHAWAN': [
        'KALAM BHAWAN - A',
        'KALAM BHAWAN - B',
        'KALAM BHAWAN - C'
    ],

    'TAGORE BHAWAN': [
        'TAGORE BHAWAN - A',
        'TAGORE BHAWAN - B',
        'TAGORE BHAWAN - C'
    ],

    'DHYAN BHAWAN': [
        'DHYAN BHAWAN'
    ],

    'SARDAR BHAWAN': [
        'SARDAR BHAWAN - A',
        'SARDAR BHAWAN - B',
        'SARDAR BHAWAN - C'
    ],

    'MILKHA BHAWAN': [
        'MILKHA BHAWAN - A'
    ],

    'ATAL BHAWAN': [
        'ATAL BHAWAN - A1',
        'ATAL BHAWAN - A2',
        'ATAL BHAWAN - B'
    ],

    'AZAD BHAWAN': [
        'AZAD BHAWAN - A'
    ],

    'TILAK BHAWAN': [
        'TILAK BHAWAN - A'
    ],

    'ABRAHAM LINCOLN BHAWAN': [
        'ABRAHAM LINCOLN - A',
        'ABRAHAM LINCOLN - B'
    ],

    'RATAN TATA BHAWAN': [
        'RATAN TATA BHAWAN'
    ],

    'SAROJINI BHAWAN': [
        'SAROJINI BHAWAN - A',
        'SAROJINI BHAWAN - B',
        'SAROJINI BHAWAN - C'
    ],

    'INDIRA BHAWAN': [
        'INDIRA BHAWAN - A',
        'INDIRA BHAWAN - B',
        'INDIRA BHAWAN - C'
    ],

    'TERESA BHAWAN': [
        'TERESA BHAWAN - A',
        'TERESA BHAWAN - B',
        'TERESA BHAWAN - C',
        'TERESA BHAWAN - D'
    ],

    'JANKI BHAWAN': [
        'JANKI BHAWAN'
    ],

    'KALPANA BHAWAN': [
        'KALPANA BHAWAN - A',
        'KALPANA BHAWAN - B'
    ],

    'SHAKUNTALA BHAWAN': [
        'SHAKUNTALA BHAWAN - A',
        'SHAKUNTALA BHAWAN - B'
    ],

    'RANI LAXMIBAI BHAWAN': [
        'RANI LAXMIBAI BHAWAN - A',
        'RANI LAXMIBAI BHAWAN - B'
    ]
};

    /* ================= helpers ================= */
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s).replace(/[&<>"']/g, c => (
        { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]
    ));

    // Builds options and preselects `current`. When allowUnknown is true and
    // `current` isn't in the list (legacy record), it's appended so existing
    // data is never lost. Pass false where the list is authoritative — e.g.
    // Indian states/districts, which must never gain a foreign value.
    function fillSelect(sel, pairs, current, placeholder, allowUnknown = true) {
        if (!sel) return;
        const cur = (current ?? '').toString();
        let html = placeholder ? `<option value="">${esc(placeholder)}</option>` : '';
        let found = false;
        pairs.forEach(([v, l]) => {
            if (v === cur) found = true;
            html += `<option value="${esc(v)}"${v === cur ? ' selected' : ''}>${esc(l)}</option>`;
        });
        if (cur && !found && allowUnknown) html += `<option value="${esc(cur)}" selected>${esc(cur)}</option>`;
        sel.innerHTML = html;
    }

    function fillStatic(id, key, placeholder) {
        const el = $(id);
        if (el) fillSelect(el, OPTIONS[key], el.dataset.current, placeholder);
    }

    fillStatic('editTitle', 'title', 'Select');
    fillStatic('editGender', 'gender', 'Select Gender');
    fillStatic('editBloodGroup', 'bloodGroup', 'Select Blood Group');
    fillStatic('editCategory', 'category');
    fillStatic('editAdmissionType', 'admissionType', 'Select');
    fillStatic('editStudentStatus', 'studentStatus');
    fillStatic('editProfileStatus', 'profileStatus');

    /* ================= hostel ================= */
    const hostelSel = $('editHostelName');
    if (hostelSel) {
        const cur = hostelSel.dataset.current || '';
        let html = '<option value="">Select Hostel</option>';
        let found = false;
        Object.entries(HOSTEL_GROUPS).forEach(([group, items]) => {
            html += `<optgroup label="${esc(group)}">`;
            items.forEach(v => {
                if (v === cur) found = true;
                html += `<option value="${esc(v)}"${v === cur ? ' selected' : ''}>${esc(v)}</option>`;
            });
            html += '</optgroup>';
        });
        if (cur && !found) html += `<option value="${esc(cur)}" selected>${esc(cur)}</option>`;
        hostelSel.innerHTML = html;
    }

    const residesSelect = $('editResidesInHostel');
    const hostelField = $('editHostelNameField');
    residesSelect.addEventListener('change', () => {
        hostelField.style.display = residesSelect.value === 'true' ? '' : 'none';
        if (residesSelect.value !== 'true' && hostelSel) hostelSel.value = '';
    });

    /* ================= academic cascade ================= */
    const facultySel = $('editFaculty');
    const instituteSel = $('editInstitute');
    const courseSel = $('editCourse');
    const branchSel = $('editBranch');
    const specSel = $('editSpecialization');

    function rebuildCascade(saved) {
        fillSelect(instituteSel, INSTITUTE_OPTIONS[facultySel.value] || [], saved.institute, 'Select Institute', false);
        fillSelect(courseSel,    COURSE_OPTIONS[instituteSel.value]  || [], saved.course,    'Select Course', false);
        fillSelect(branchSel,    BRANCH_OPTIONS[courseSel.value]     || [], saved.branch,    'Select Branch', false);
        fillSelect(specSel,      SPECIALIZATION_OPTIONS[branchSel.value] || [], saved.specialization, 'Select Specialization', false);
    }

    fillSelect(facultySel, FACULTY_OPTIONS, facultySel.dataset.current, 'Select Faculty', false);
    rebuildCascade({
        institute: instituteSel.dataset.current,
        course: courseSel.dataset.current,
        branch: branchSel.dataset.current,
        specialization: specSel.dataset.current,
    });

    facultySel.addEventListener('change',   () => rebuildCascade({}));
    instituteSel.addEventListener('change', () => {
        fillSelect(courseSel, COURSE_OPTIONS[instituteSel.value] || [], '', 'Select Course');
        fillSelect(branchSel, [], '', 'Select Branch');
        fillSelect(specSel, [], '', 'Select Specialization');
    });
    courseSel.addEventListener('change', () => {
        fillSelect(branchSel, BRANCH_OPTIONS[courseSel.value] || [], '', 'Select Branch');
        fillSelect(specSel, [], '', 'Select Specialization');
    });
    branchSel.addEventListener('change', () => {
        fillSelect(specSel, SPECIALIZATION_OPTIONS[branchSel.value] || [], '', 'Select Specialization');
    });

    /* ================= reference JSON ================= */
    let states = [], districts = {}, codes = [];
    try {
        [states, districts, codes] = await Promise.all([
            fetch('/data/indiaStates.json').then(r => r.json()),
            fetch('/data/indiaDistricts.json').then(r => r.json()),
            fetch('/data/countryCodes.json').then(r => r.json()),
        ]);
    } catch (err) {
        console.error('Failed to load reference data:', err);
    }

    ['studentPhoneCode', 'fatherPhoneCode', 'motherPhoneCode', 'emergencyPhoneCode'].forEach(id => {
        const el = $(id);
        if (!el) return;
        fillSelect(el, codes.map(c => [c.dialCode, `${c.name} (${c.dialCode})`]), el.dataset.current || '+91');
    });

    /* =========================================================
       Address: country drives whether State/District are
       dropdowns (India) or free text (anywhere else). The saved
       values are pre-filled into whichever control is active,
       and only the visible control carries the `name` so the
       hidden one can never post an empty overwrite.
       ========================================================= */
    function setupAddress(prefix, base) {
        const countrySel  = $(prefix + 'Country');
        const countryText = $(prefix + 'CountryText');
        const stateSel    = $(prefix + 'State');
        const stateText   = $(prefix + 'StateText');
        const distSel     = $(prefix + 'District');
        const distText    = $(prefix + 'DistrictText');

        function fillStates(current) {
            fillSelect(stateSel, states.map(s => [s, s]), current, 'Select State', false);
        }
        function fillDistricts(current) {
            fillSelect(distSel, (districts[stateSel.value] || []).map(d => [d, d]), current, 'Select District', false);
        }

        // Initial population from stored values. A foreign state/district
        // simply won't match, leaving the placeholder selected — it lives in
        // the text inputs instead.
        fillStates(stateSel.dataset.current);
        fillDistricts(distSel.dataset.current);

        stateSel.addEventListener('change', () => fillDistricts(''));

        function apply() {
            const isIndia = countrySel.value === 'India';

            countrySel.style.display  = '';
            countryText.style.display = isIndia ? 'none' : '';
            countryText.style.marginTop = isIndia ? '' : '8px';
            stateSel.style.display    = isIndia ? '' : 'none';
            stateText.style.display   = isIndia ? 'none' : '';
            distSel.style.display     = isIndia ? '' : 'none';
            distText.style.display    = isIndia ? 'none' : '';

            if (isIndia) {
                countrySel.name = `${base}[country]`;
                stateSel.name   = `${base}[state]`;
                distSel.name    = `${base}[district]`;
                countryText.removeAttribute('name');
                stateText.removeAttribute('name');
                distText.removeAttribute('name');
                stateSel.required = true;  distSel.required = true;
                stateText.required = false; distText.required = false; countryText.required = false;
            } else {
                countryText.name = `${base}[country]`;
                stateText.name   = `${base}[state]`;
                distText.name    = `${base}[district]`;
                countrySel.removeAttribute('name');
                stateSel.removeAttribute('name');
                distSel.removeAttribute('name');
                stateSel.required = false; distSel.required = false;
                stateText.required = true; distText.required = true; countryText.required = true;
            }
        }

        countrySel.addEventListener('change', apply);
        apply();
    }

    setupAddress('present', 'presentAddress');
    setupAddress('permanent', 'permanentAddress');

    /* ================= nationality / category ================= */
    const natType    = $('editNationalityType');
    const natField   = $('editNationalityField');
    const natInput   = $('editNationality');
    const categorySel= $('editCategory');
    const indianOnly = $('indianOnlyFields');
    const intlOnly   = $('internationalOnlyFields');
    const indianDocs = $('indianEducationDocs');
    const intlDocs   = $('internationalDocs');
    const casteRow   = $('editCasteProofRow');
    const pwdRow     = $('editPwdProofRow');

    function updateCategoryUI() {
        const indian = natType.value === 'Indian';
        const cat = categorySel.value;
        casteRow.style.display = (indian && cat !== 'General' && cat !== 'PWD') ? '' : 'none';
        pwdRow.style.display   = (indian && cat === 'PWD') ? '' : 'none';
    }

    function updateNationalityUI() {
        const indian = natType.value === 'Indian';

        natField.style.display = indian ? 'none' : '';
        natInput.required = !indian;
        // The text input always carries the real value that gets saved.
        if (indian) {
            natInput.value = 'Indian';
        } else if (natInput.value.trim().toLowerCase() === 'indian') {
            natInput.value = '';
        }

        indianOnly.style.display = indian ? '' : 'none';
        intlOnly.style.display   = indian ? 'none' : '';
        indianDocs.style.display = indian ? '' : 'none';
        intlDocs.style.display   = indian ? 'none' : '';

        updateCategoryUI();
    }

    natType.addEventListener('change', updateNationalityUI);
    categorySel.addEventListener('change', updateCategoryUI);
    updateNationalityUI();

    /* ================= 12th vs Diploma ================= */
    const qualType      = $('editQualificationType');
    const qualSchool    = $('editQualSchool');
    const qualPct       = $('editQualPercentage');
    const qualMarksheet = $('editQualMarksheet');
    const qualSchoolLbl = $('editQualSchoolLabel');
    const qualMsLbl     = $('editQualMarksheetLabel');

    qualType.addEventListener('change', () => {
        const key = qualType.value;
        qualSchool.name    = `education[${key}][schoolName]`;
        qualPct.name       = `education[${key}][percentage]`;
        qualMarksheet.name = `education[${key}][marksheet]`;
        qualSchoolLbl.textContent = key === 'diploma' ? 'Diploma Institute Name' : 'School / College Name';
        qualMsLbl.textContent = `Replace ${key === 'diploma' ? 'Diploma' : '12th'} Marksheet (leave blank to keep existing)`;
    });

    /* =========================================================
       Dirty tracking — Save Changes stays disabled until the
       admin actually changes something. The baseline is taken
       only after every select above has been populated, so the
       page's own initialisation never counts as an edit.
       ========================================================= */
    const form = document.getElementById('editStudentForm');
    const saveBtn = $('saveChangesBtn');
    const hint = $('unsavedHint');

    // Serialises the form. Files are represented by name/size, since
    // FormData hands back File objects that never compare equal.
    function snapshot() {
        const parts = [];
        for (const [key, value] of new FormData(form)) {
            parts.push(value instanceof File
                ? `${key}=file:${value.name}:${value.size}`
                : `${key}=${value}`);
        }
        return parts.join('\u001f');
    }

    let baseline = snapshot();

    function refreshDirtyState() {
        const dirty = snapshot() !== baseline;
        saveBtn.disabled = !dirty;
        hint.textContent = dirty ? 'Unsaved changes' : 'No changes yet';
    }

    form.addEventListener('input', refreshDirtyState);
    form.addEventListener('change', refreshDirtyState);

    refreshDirtyState();

    // Warn before losing edits via back/refresh/close.
    window.addEventListener('beforeunload', (e) => {
        if (snapshot() !== baseline) e.preventDefault();
    });

    // Submitting is not "leaving with unsaved changes".
    form.addEventListener('submit', () => {
        baseline = snapshot();
        saveBtn.disabled = true;
        hint.textContent = 'Saving…';
    });
});
</script>
