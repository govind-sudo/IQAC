<% layout('layout/adminBoilerPlate') %>

<style>
    .edit-profile-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: 16px;
    }

    .page-header {
        margin-bottom: 24px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #2563eb;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        margin-bottom: 12px;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .back-link:hover {
        color: #1d4ed8;
        transform: translateX(-3px);
    }

    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .page-header p {
        color: #64748b;
        font-size: 0.95rem;
    }

    /* Form Card Styles */
    .form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        padding: 28px;
        transition: box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .form-card:hover {
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.06), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
        border-color: #cbd5e1;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 20px;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group.full-width {
        grid-column: span 2;
    }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
    }

    .form-group label .required {
        color: #ef4444;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #1e293b;
        background-color: #ffffff;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Form Action Buttons */
    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-secondary {
        padding: 10px 20px;
        border-radius: 8px;
        background-color: #f1f5f9;
        color: #475569;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .btn-secondary:hover {
        background-color: #e2e8f0;
        color: #1e293b;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 8px;
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover {
        background-color: #1d4ed8;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

    /* Error Alert Popup */
    .alert-popup.error {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Responsive Queries */
    @media (max-width: 640px) {
        .edit-profile-container {
            padding: 12px;
        }

        .form-card {
            padding: 20px 16px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .form-group.full-width {
            grid-column: span 1;
        }

        .form-actions {
            flex-direction: column-reverse;
            width: 100%;
        }

        .btn-secondary, .btn-primary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="edit-profile-container">
    <!-- Header Section -->
    <header class="page-header">
        <a href="/admin/profile" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to Profile
        </a>

        <p>Modify administrator profile settings and system access details.</p>
    </header>

    <div class="form-card">

        <!-- Error Alert Banner -->
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert-popup error">
                <i class="fa-solid fa-circle-exclamation" style="font-size: 1.2rem;"></i>
                <div style="flex: 1;">
                    <strong>Update Failed</strong>
                    <p style="margin: 0; font-size: 0.85rem;"><%= errorMessage %></p>
                </div>
                <button type="button" onclick="this.parentElement.remove();" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #991b1b;">&times;</button>
            </div>
        <% } %>

        <form action="/admin/<%= adminToEdit._id %>/edit" method="POST" class="edit-profile-form">
            
            <!-- Personal Details Section -->
            <h3 class="section-title">
                <i class="fa-solid fa-user-pen" style="color: #2563eb;"></i> Personal Details
            </h3>

            <div class="form-grid">
                <!-- Full Name -->
                <div class="form-group">
                    <label for="fullName">Full Name <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="fullName" 
                        name="fullName" 
                        value="<%= adminToEdit.fullName %>" 
                        placeholder="e.g., Jane Doe" 
                        required 
                        autocomplete="off"
                    />
                </div>

                <!-- MIS Code -->
                <div class="form-group">
                    <label for="misCode">MIS Code <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="misCode" 
                        name="misCode" 
                        value="<%= adminToEdit.misCode %>" 
                        placeholder="e.g., MIS1029" 
                        required 
                        autocomplete="off"
                        style="text-transform: uppercase;"
                    />
                </div>

                <!-- Email Address -->
                <div class="form-group">
                    <label for="email">Email Address <span class="required">*</span></label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="<%= adminToEdit.email %>" 
                        placeholder="e.g., admin@example.com" 
                        required 
                        autocomplete="off"
                    />
                </div>

                <!-- Phone Number -->
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        value="<%= adminToEdit.phone || '' %>" 
                        placeholder="e.g., +91 9876543210" 
                        autocomplete="off"
                    />
                </div>
            </div>

            <!-- Role & Status Control Section -->
            <h3 class="section-title" style="margin-top: 12px;">
                <i class="fa-solid fa-user-gear" style="color: #2563eb;"></i> Account & Authorization Settings
            </h3>

            <div class="form-grid">
                <!-- Role Dropdown -->
                <div class="form-group">
                    <label for="role">Assigned Role <span class="required">*</span></label>
                    <select id="role" name="role" required>
                        <option value="admin" <%= adminToEdit.role === 'admin' ? 'selected' : '' %>>Admin</option>
                        <option value="subadmin" <%= adminToEdit.role === 'subadmin' ? 'selected' : '' %>>Sub Admin</option>
                    </select>
                </div>

                <!-- Account Status Dropdown -->
                <div class="form-group">
                    <label for="isActive">Account Status <span class="required">*</span></label>
                    <select id="isActive" name="isActive" required>
                        <option value="true" <%= adminToEdit.isActive ? 'selected' : '' %>>Active</option>
                        <option value="false" <%= !adminToEdit.isActive ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions">
                <a href="/admin/profile" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>