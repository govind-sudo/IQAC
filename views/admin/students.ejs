<% layout('layout/adminBoilerPlate') %>

<div class="students-page-container">
    <!-- Header Section -->
    <header class="page-header">
        <div class="header-text">
            <h1>Student Management</h1>
            <p>View, search, edit, and manage all registered student profiles.</p>
        </div>
    </header>

    <!-- Toolbar: Search Form + Bulk Upload Button -->
    <div class="table-toolbar" style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 12px; flex: 1; max-width: 650px; width: 100%;">
            <form action="/admin/students" method="GET" class="search-form" id="studentSearchForm" style="display: flex; align-items: center; gap: 8px; flex: 1;">
                <div class="search-box" style="position: relative; flex: 1;">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input 
                        type="text" 
                        name="search" 
                        id="studentSearchInput" 
                        value="<%= typeof search !== 'undefined' ? search : '' %>" 
                        placeholder="Search by student name, enrollment no, or contact..." 
                        autocomplete="off"
                    />
                    <% if (typeof search !== 'undefined' && search) { %>
                        <a href="/admin/students" class="clear-search-btn" title="Clear Search">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    <% } %>
                </div>
                <button type="submit" class="btn-search" style="padding: 10px 18px; border-radius: 8px; border: 1px solid #cbd5e1; background-color: #2563eb; color: #ffffff; font-weight: 500; cursor: pointer; white-space: nowrap;">Search</button>
            </form>

            <!-- Bulk Upload Trigger Button -->
            <button type="button" id="openExcelModalBtn" class="btn-excel-upload" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 8px; border: 1px solid #16a34a; background-color: #16a34a; color: #ffffff; font-weight: 500; cursor: pointer; white-space: nowrap;">
                <i class="fa-solid fa-file-excel"></i> Update Enrollments
            </button>
        </div>
        
        <div class="record-counter">
            Total Students: <strong><%= typeof totalStudents !== 'undefined' ? totalStudents : 0 %></strong>
        </div>
    </div>

    <!-- Students Table Card -->
    <div class="card table-card">
        <div class="table-responsive">
            <table class="students-table" id="studentsTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Name</th>
                        <th>Enrollment / UG No.</th>
                        <th>Contact Number</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof students !== 'undefined' && students && students.length > 0) { %>
                        <% students.forEach((student, index) => { %>
                            <tr class="student-row">
                                <td><%= (page - 1) * limit + index + 1 %></td>
                                <td class="student-name-cell">
                                    <a href="/admin/students/<%= student._id %>/inDetail" class="student-profile-link">
                                        <div class="avatar-placeholder">
                                            <%= (student.firstName ? student.firstName[0] : 'S').toUpperCase() %>
                                        </div>
                                        <div class="name-info">
                                            <span class="full-name"><%= student.fullName || (student.firstName + ' ' + student.lastName) %></span>
                                            <span class="email-sub"><%= student.email %></span>
                                        </div>
                                    </a>
                                </td>
                                <td>
                                    <div class="id-badge-container">
                                        <span class="ug-badge"><%= student.ugNumber %></span>
                                        <% if (student.enrollmentNo) { %>
                                            <span class="enrollment-sub"><%= student.enrollmentNo %></span>
                                        <% } else { %>
                                            <span class="enrollment-sub missing">No Enrollment</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <% if (student.phone) { %>
                                        <a href="tel:<%= student.phoneCode || '+91' %><%= student.phone %>" class="phone-link">
                                            <i class="fa-solid fa-phone"></i> <%= student.phoneCode || '+91' %> <%= student.phone %>
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted">N/A</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="status-pill status-<%= (student.studentStatus || 'active').toLowerCase() %>">
                                        <%= (student.studentStatus || 'active').toUpperCase() %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a href="/admin/students/<%= student._id %>/edit" class="btn-action edit" title="Edit Student Details">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </a>

                                        <button 
                                            type="button" 
                                            class="btn-action delete btn-delete-trigger" 
                                            data-id="<%= student._id %>" 
                                            data-name="<%= student.fullName || (student.firstName + ' ' + student.lastName) %>"
                                            title="Delete Student"
                                        >
                                            <i class="fa-solid fa-trash-can"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr id="noDataRow">
                            <td colspan="6" class="empty-state">
                                <i class="fa-solid fa-user-slash empty-icon"></i>
                                <p>No students found matching your search.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination Toolbar -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="pagination-container">
                <div class="pagination-info">
                    Showing Page <strong><%= page %></strong> of <strong><%= totalPages %></strong>
                </div>

                <div class="pagination-controls">
                    <% if (hasPrevPage) { %>
                        <a href="/admin/students?page=<%= prevPage %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-btn prev">
                            <i class="fa-solid fa-chevron-left"></i> Previous
                        </a>
                    <% } else { %>
                        <button class="pagination-btn prev disabled" disabled>
                            <i class="fa-solid fa-chevron-left"></i> Previous
                        </button>
                    <% } %>

                    <% if (hasNextPage) { %>
                        <a href="/admin/students?page=<%= nextPage %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-btn next">
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    <% } else { %>
                        <button class="pagination-btn next disabled" disabled>
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal: Excel Bulk Upload -->
<div class="modal-overlay" id="excelUploadModal" style="display: none;">
    <div class="modal-box" style="max-width: 500px; width: 90%;">
        <div class="modal-header">
            <div class="warning-icon-wrapper" style="background-color: #dcfce7; color: #16a34a;">
                <i class="fa-solid fa-file-excel"></i>
            </div>
            <h3>Bulk Update Enrollment Numbers</h3>
        </div>
        <form id="excelUploadForm" enctype="multipart/form-data">
            <div class="modal-body">
                <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 12px;">
                    Upload an Excel file (<code>.xlsx</code> or <code>.xls</code>) containing <strong>ugNumber</strong> and <strong>enrollmentNo</strong> columns.
                </p>
                <div class="file-drop-area" style="border: 2px dashed #cbd5e1; border-radius: 8px; padding: 20px; text-align: center; background-color: #f8fafc; cursor: pointer;">
                    <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2rem; color: #94a3b8; margin-bottom: 8px;"></i>
                    <p style="margin: 0; font-weight: 500; color: #334155;">Click to select Excel sheet</p>
                    <span id="selectedFileName" style="display: block; margin-top: 6px; font-size: 0.85rem; color: #16a34a; font-weight: 600;"></span>
                    <input type="file" id="excelFileInput" name="excelFile" accept=".xlsx, .xls" style="display: none;" required />
                </div>
                <div id="uploadStatusMessage" style="margin-top: 12px; font-size: 0.85rem; display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="cancelExcelModalBtn">Cancel</button>
                <button 
    type="submit" 
    id="submitExcelBtn" 
    style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 8px; border: none; background: linear-gradient(135deg, #16a34a, #15803d); color: #ffffff; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 4px rgba(22, 163, 74, 0.25); transition: all 0.2s ease-in-out;"
    onmouseover="this.style.background='linear-gradient(135deg, #15803d, #166534)'; this.style.boxShadow='0 4px 8px rgba(22, 163, 74, 0.35)'; this.style.transform='translateY(-1px)';"
    onmouseout="this.style.background='linear-gradient(135deg, #16a34a, #15803d)'; this.style.boxShadow='0 2px 4px rgba(22, 163, 74, 0.25)'; this.style.transform='translateY(0)';"
>
    <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Update
</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal-overlay" id="deleteConfirmModal">
    <div class="modal-box">
        <div class="modal-header">
            <div class="warning-icon-wrapper">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3>Confirm Student Deletion</h3>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete student <strong id="deleteStudentName"></strong>?</p>
            <p class="warning-text">This action is permanent and cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" id="cancelDeleteBtn">Cancel</button>
            <form id="deleteStudentForm" method="POST" action="">
                <button type="submit" class="btn-danger">Delete Student</button>
            </form>
        </div>
    </div>
</div>

<!-- Page Scripts -->
<script src="/js/admin/students.js"></script>