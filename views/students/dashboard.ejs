</div>

        </div>


        <!-- CENTER COLUMN -->

        <div class="center-column">

            <div class="card academic-card">

    <div class="card-header">

        <div class="title">

            <div class="title-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h2>
                Academic Information
            </h2>

        </div>

    </div>


    <div class="card-body academic-body">


