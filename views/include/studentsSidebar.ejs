            </div>

            <div class="logo-text">
                <h2>IQAC</h2>
                <p>Internal Quality</p>
                <p>Assurance for Students</p>
            </div>

        </div>

        <!-- ===================== -->
        <!-- Navigation -->
        <!-- ===================== -->

        <nav class="sidebar-nav">

            <ul>

                <li class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
                    <a href="/students/dashboard">
                        <i class="fa-solid fa-house"></i>
