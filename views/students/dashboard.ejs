           <div class="card documents-card">
    <div class="card-header">
        <div class="title">
            <div class="title-icon doc-main-icon">
                <i class="fa-regular fa-folder-open"></i>
            </div>
            <h2>Documents</h2>
        </div>
        <a href="/students/documents">View All</a>
    </div>

    <div class="card-body documents-body">
        <%
        const docList = isIndian
          ? [
              { name: "Aadhaar Card", uploaded: !!studentInfo.documents?.aadhaarProof, iconClass: "doc-red", icon: "fa-solid fa-file-pdf" },
              { name: "10th Marksheet", uploaded: !!studentInfo.education?.tenth?.marksheet, iconClass: "doc-purple", icon: "fa-solid fa-file-invoice" },
              { name: (studentInfo.education?.diploma ? "Diploma Marksheet" : "12th Marksheet"), uploaded: !!(studentInfo.education?.twelfth?.marksheet || studentInfo.education?.diploma?.marksheet), iconClass: "doc-orange", icon: "fa-solid fa-file-lines" },
              { name: "Leaving Certificate", uploaded: !!studentInfo.documents?.leavingCertificate, iconClass: "doc-blue", icon: "fa-solid fa-file-image" },
              { name: "ABC/APAAR ID Proof", uploaded: !!studentInfo.documents?.abcIdProof, iconClass: "doc-darkblue", icon: "fa-solid fa-file-zipper" }
            ]
          : [
              { name: "Passport", uploaded: !!studentInfo.documents?.passportUpload, iconClass: "doc-red", icon: "fa-solid fa-passport" },
              { name: "A/O Level Certificate", uploaded: !!studentInfo.documents?.aoLevelCertificate, iconClass: "doc-purple", icon: "fa-solid fa-file-invoice" },
              { name: "PU Admission Letter", uploaded: !!studentInfo.documents?.puAdmissionLetter, iconClass: "doc-orange", icon: "fa-solid fa-file-lines" }
            ];

        docList.forEach(doc => { %>
            <div class="document-item">
                <div class="document-left">
                    <div class="doc-icon <%= doc.iconClass %>">
                        <i class="<%= doc.icon %>"></i>
                    </div>
                    <span class="doc-name"><%= doc.name %></span>
                </div>
                <div class="document-right">
                    <% if (doc.uploaded) { %>
                        <span class="doc-status status-uploaded">
                            <i class="fa-regular fa-circle-check"></i> Uploaded
                        </span>
                    <% } else { %>
                        <span class="doc-status status-pending">
                            <i class="fa-regular fa-circle-dot"></i> Not Uploaded
                        </span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

        </div>


        <!-- RIGHT COLUMN -->

        <div class="right-column">

           <div class="card overview-card">
    <div class="overview-header">
        <h2>Profile Overview</h2>
    </div>

    <!-- Inline style mapping allows dynamic injection into the CSS background conic-gradient properties -->
    <div class="profile-circle" style="--progress: <%= profilePercent || 0 %>;">
        <div class="circle-inner">
            <h1><%= profilePercent || 0 %>%</h1>
            <span>Complete</span>
        </div>
    </div>

    <div class="overview-list">
        <% sectionsList.forEach(sec => { %>
            <div class="overview-item">
                <div class="overview-item-left">
                    <% if(sec.pct === 100) { %>
                        <i class="fa-solid fa-circle-check icon-complete"></i>
                    <% } else { %>
                        <i class="fa-regular fa-circle icon-incomplete"></i>
                    <% } %>
                    <span class="section-label"><%= sec.label %></span>
                </div>
                <strong class="section-value"><%= sec.pct %>%</strong>
            </div>
        <% }) %>
    </div>

    
</div>


          <div class="card quick-card">
    <div class="card-header quick-header">
        <div class="title">
            <div class="title-icon quick-main-icon" style="background-color: white;">
                <i class="fa-solid fa-circle-info"></i>
            </div>
            <h2>Quick Info</h2>
        </div>
    </div>

    <div class="card-body quick-body">
        <% 
        // Build Hostel display string dynamically based on the schema boolean and name values
        let hostelStatus = "No";
        if (studentInfo.residesInHostel) {
            hostelStatus = `Yes (${studentInfo.hostelName || 'Assigned'})`;
        }

        // Format joining date if available
        let formattedJoiningDate = "-";
        if (studentInfo.joiningDate) {
            formattedJoiningDate = new Date(studentInfo.joiningDate).toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "short",
                year: "numeric"
            });
        }

        const quickItems = [
            { label: "Enrollment No", value: studentInfo.enrollmentNo || "-", icon: "fa-regular fa-address-card" },
            { label: "UG Number", value: studentInfo.ugNumber || "-", icon: "fa-solid fa-briefcase" },
            { label: "Joining Date", value: formattedJoiningDate, icon: "fa-regular fa-calendar-days" },
            { label: "Hostel", value: hostelStatus, icon: "fa-solid fa-hotel" },
            { label: "ABC ID", value: studentInfo.abcId || "Not Generated", icon: "fa-regular fa-id-badge" }
        ];

        quickItems.forEach(item => {
        %>
            <div class="quick-row-item">
                <div class="quick-item-left">
                    <div class="quick-icon-box">
                        <i class="<%= item.icon %>"></i>
                    </div>
                    <span class="quick-label"><%= item.label %></span>
                </div>
                <strong class="quick-value"><%= item.value %></strong>
            </div>
        <% }) %>
    </div>
</div>

        </div>

    </section>

</div>