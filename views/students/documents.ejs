<% layout('layout/studentsBoilerPlate') %>

<link rel="stylesheet" href="/css/students/studentsDocuments.css">

<div class="documents-info-container">
    <div class="info-section-card documents-card">
        
        <div class="section-card-header">
            <div class="section-title-icon">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <h3>Uploaded Documents & Verification Vault</h3>
        </div>

        <div class="academic-card-body">
            
            <% if (student.nationality && student.nationality.toLowerCase() === 'indian') { %>
                <!-- ==========================================================================
                     INDIAN STUDENT DOCUMENTATION SECTION
                     ========================================================================== -->
                
                <div class="academic-sub-section">
                    <h4 class="academic-section-title">Identity & Category Details (Domestic)</h4>
                    <div class="documents-grid text-fields-only">
                        <div class="detail-text-row">
                            <span class="detail-label">Category</span>
                            <span class="detail-val"><%= student.category || 'General' %></span>
                        </div>
                        <div class="detail-text-row">
                            <span class="detail-label">Caste</span>
                            <span class="detail-val"><%= student.caste || 'Not Given' %></span>
                        </div>
                    </div>
                </div>

                <div class="academic-divider"></div>

                <div class="academic-sub-section">
                    <h4 class="academic-section-title">Required Identity & Verification Documents</h4>
                    <% 
                      const hasAnyDoc = !!(
                        student.documents?.aadhaarProof ||
                        student.documents?.abcIdProof ||
                        student.documents?.leavingCertificate ||
                        student.documents?.casteProof ||
                        student.documents?.pwdProof ||
                        student.education?.tenth?.marksheet ||
                        student.education?.twelfth?.marksheet ||
                        student.education?.diploma?.marksheet
                      );
                    %>

                    <% if (!hasAnyDoc) { %>
                        <div class="documents-empty-state">
                            <i class="fa-solid fa-folder-open empty-state-icon"></i>
                            <p>No documents uploaded yet.</p>
                        </div>
                    <% } else { %>
                        <div class="documents-grid">
                        
                            <!-- Aadhaar Card -->
                            <div class="document-item-box">
                                <div class="document-meta-side">
                                    <div class="doc-icon-wrapper identification">
                                        <i class="fa-solid fa-id-card"></i>
                                    </div>
                                    <div class="doc-text-details">
                                        <span class="doc-label">Aadhaar Card Number</span>
                                        <span class="doc-value font-monospace">
                                            <%= student.aadhaarNumber ? 'XXXXXXXX' + student.aadhaarNumber.slice(-4) : 'Not Given' %>
                                        </span>
                                    </div>
                                </div>
                                <div class="document-file-side">
                                    <% if (student.documents && student.documents.aadhaarProof) { %>
                                        <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="Aadhaar Card" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.aadhaarProof) %>">
                                            <i class="fa-solid fa-eye"></i> View Document
                                        </button>
                                    <% } else { %>
                                        <span class="file-status-badge missing">
                                            <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        
                            <!-- ABC / APAAR ID -->
                            <div class="document-item-box">
                                <div class="document-meta-side">
                                    <div class="doc-icon-wrapper identification">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div class="doc-text-details">
                                        <span class="doc-label">ABC / APAAR Identity</span>
                                        <span class="doc-value font-monospace"><%= student.abcId || 'Not Given' %></span>
                                    </div>
                                </div>
                                <div class="document-file-side">
                                    <% if (student.documents && student.documents.abcIdProof) { %>
                                        <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="ABC / APAAR ID Proof" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.abcIdProof) %>">
                                            <i class="fa-solid fa-eye"></i> View Document
                                        </button>
                                    <% } else { %>
                                        <span class="file-status-badge missing">
                                            <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        
                            <!-- 10th Marksheet -->
                            <div class="document-item-box">
                                <div class="document-meta-side">
                                    <div class="doc-icon-wrapper media">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div class="doc-text-details">
                                        <span class="doc-label">10th Standard Marksheet</span>
                                        <span class="doc-value-status"><%= student.education?.tenth?.schoolName || 'Not Given' %></span>
                                    </div>
                                </div>
                                <div class="document-file-side">
                                    <% if (student.education && student.education.tenth && student.education.tenth.marksheet) { %>
                                        <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="10th Marksheet" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.education.tenth.marksheet) %>">
                                            <i class="fa-solid fa-eye"></i> View Document
                                        </button>
                                    <% } else { %>
                                        <span class="file-status-badge missing">
                                            <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        
                            <!-- 12th / Diploma Marksheet -->
                            <div class="document-item-box">
                                <div class="document-meta-side">
                                    <div class="doc-icon-wrapper media">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div class="doc-text-details">
                                        <span class="doc-label">
                                            <%= student.education?.diploma ? 'Diploma Marksheet' : '12th Standard Marksheet' %>
                                        </span>
                                        <span class="doc-value-status">
                                            <%= (student.education?.twelfth?.schoolName || student.education?.diploma?.schoolName) || 'Not Given' %>
                                        </span>
                                    </div>
                                </div>
                                <div class="document-file-side">
                                    <% const qualMarksheetIndian = (student.education?.twelfth?.marksheet) || (student.education?.diploma?.marksheet); %>
                                    <% if (qualMarksheetIndian) { %>
                                        <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="12th/Diploma Marksheet" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(qualMarksheetIndian) %>">
                                            <i class="fa-solid fa-eye"></i> View Document
                                        </button>
                                    <% } else { %>
                                        <span class="file-status-badge missing">
                                            <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        
                            <!-- Leaving Certificate -->
                            <div class="document-item-box">
                                <div class="document-meta-side">
                                    <div class="doc-icon-wrapper media">
                                        <i class="fa-solid fa-file-invoice"></i>
                                    </div>
                                    <div class="doc-text-details">
                                        <span class="doc-label">School Leaving Certificate (LC)</span>
                                        <span class="doc-value-status">Verification Certificate</span>
                                    </div>
                                </div>
                                <div class="document-file-side">
                                    <% if (student.documents && student.documents.leavingCertificate) { %>
                                        <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="School Leaving Certificate" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.leavingCertificate) %>">
                                            <i class="fa-solid fa-eye"></i> View Document
                                        </button>
                                    <% } else { %>
                                        <span class="file-status-badge missing">
                                            <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        
                            <!-- Caste Certificate -->
                            <% if (student.category && student.category !== 'General') { %>
                                <div class="document-item-box conditional-required">
                                    <div class="document-meta-side">
                                        <div class="doc-icon-wrapper validation">
                                            <i class="fa-solid fa-award"></i>
                                        </div>
                                        <div class="doc-text-details">
                                            <span class="doc-label">Caste Certificate</span>
                                            <span class="doc-value-status text-danger-light">Mandatory for <%= student.category %> category</span>
                                        </div>
                                    </div>
                                    <div class="document-file-side">
                                        <% if (student.documents && student.documents.casteProof) { %>
                                            <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="Caste Certificate" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.casteProof) %>">
                                                <i class="fa-solid fa-eye"></i> View Document
                                            </button>
                                        <% } else { %>
                                            <span class="file-status-badge missing">
                                                <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                            <!-- PWD Certificate -->
                            <%# Shown whenever the student is in the PWD category OR a
                                certificate is already on file. The second condition
                                matters: if an admin later corrects the category, a
                                document the student already uploaded must not silently
                                vanish from their own page. %>
                            <% if (student.category === 'PWD' || (student.documents && student.documents.pwdProof)) { %>
                                <div class="document-item-box conditional-required">
                                    <div class="document-meta-side">
                                        <div class="doc-icon-wrapper validation">
                                            <i class="fa-solid fa-wheelchair"></i>
                                        </div>
                                        <div class="doc-text-details">
                                            <span class="doc-label">PWD Certificate</span>
                                            <% if (student.category === 'PWD') { %>
                                                <span class="doc-value-status text-danger-light">Mandatory for PWD category</span>
                                            <% } else { %>
                                                <span class="doc-value-status">Submitted supporting document</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="document-file-side">
                                        <% if (student.documents && student.documents.pwdProof) { %>
                                            <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="PWD Certificate" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.pwdProof) %>">
                                                <i class="fa-solid fa-eye"></i> View Document
                                            </button>
                                        <% } else { %>
                                            <span class="file-status-badge missing">
                                                <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                        </div>
                    <% } %>
                </div>

            <% } else { %>
                <!-- ==========================================================================
                     INTERNATIONAL STUDENT DOCUMENTATION SECTION
                     ========================================================================== -->
                <div class="academic-sub-section">
                    <h4 class="academic-section-title">Passport & Visa Details (International)</h4>
                    <div class="documents-grid text-fields-only">
                        <div class="detail-text-row">
                            <span class="detail-label">Passport Number</span>
                            <span class="detail-val font-monospace"><%= student.passportNumber || 'Not Given' %></span>
                        </div>
                    </div>
                </div>

                <div class="academic-divider"></div>

                <div class="academic-sub-section">
                    <h4 class="academic-section-title">International Admission Documents</h4>
                    <div class="documents-grid">
                        
                        <!-- Passport File -->
                        <div class="document-item-box">
                            <div class="document-meta-side">
                                <div class="doc-icon-wrapper identification">
                                    <i class="fa-solid fa-passport"></i>
                                </div>
                                <div class="doc-text-details">
                                    <span class="doc-label">Passport Main Pages Document</span>
                                    <span class="doc-value-status">Identification Copy</span>
                                </div>
                            </div>
                            <div class="document-file-side">
                                <% if (student.documents && student.documents.passportUpload) { %>
                                    <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="Passport Document" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.passportUpload) %>">
                                        <i class="fa-solid fa-eye"></i> View Document
                                    </button>
                                <% } else { %>
                                    <span class="file-status-badge missing">
                                        <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <!-- A/O Level Certificate -->
                        <div class="document-item-box">
                            <div class="document-meta-side">
                                <div class="doc-icon-wrapper verification">
                                    <i class="fa-solid fa-certificate"></i>
                                </div>
                                <div class="doc-text-details">
                                    <span class="doc-label">A / O Level Passing Certificate</span>
                                    <span class="doc-value-status">Prior Academic Eligibility Proof</span>
                                </div>
                            </div>
                            <div class="document-file-side">
                                <% if (student.documents && student.documents.aoLevelCertificate) { %>
                                    <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="A/O Level Certificate" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.aoLevelCertificate) %>">
                                        <i class="fa-solid fa-eye"></i> View Document
                                    </button>
                                <% } else { %>
                                    <span class="file-status-badge missing">
                                        <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <!-- PU Admission Letter -->
                        <div class="document-item-box">
                            <div class="document-meta-side">
                                <div class="doc-icon-wrapper validation">
                                    <i class="fa-solid fa-file-signature"></i>
                                </div>
                                <div class="doc-text-details">
                                    <span class="doc-label">Parul University Admission Letter</span>
                                    <span class="doc-value-status">Official Offer Allotment PDF</span>
                                </div>
                            </div>
                            <div class="document-file-side">
                                <% if (student.documents && student.documents.puAdmissionLetter) { %>
                                    <button type="button" class="file-status-badge uploaded view-doc-trigger" data-doc-title="PU Admission Letter" data-doc-url="/students/documents/file?path=<%= encodeURIComponent(student.documents.puAdmissionLetter) %>">
                                        <i class="fa-solid fa-eye"></i> View Document
                                    </button>
                                <% } else { %>
                                    <span class="file-status-badge missing">
                                        <i class="fa-solid fa-circle-exclamation"></i> Document Not Uploaded
                                    </span>
                                <% } %>
                            </div>
                        </div>


                    </div>
                </div>
            <% } %>

        </div>
    </div>
</div>

<!-- ==========================================================================
     POPUP LIGHTBOX MODAL (ON-PAGE VIEWPORT CONTAINER)
     ========================================================================== -->
<div id="documentViewModal" class="doc-popup-modal">
    <div class="doc-popup-overlay"></div>
    <div class="doc-popup-wrapper">
        <div class="doc-popup-header">
            <div class="header-left">
                <i class="fa-solid fa-file-invoice"></i>
                <h4 id="modalDocTitle">Document Preview</h4>
            </div>
            <button type="button" class="doc-popup-close-btn" id="closeModalBtn">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <!-- Single body container — JS injects either an <img> or <iframe>
             into this, always with id="modalDocFrame" so the CSS sizing
             rule (#modalDocFrame { width:100%; height:100%; position:absolute; })
             applies regardless of which element type gets created. -->
        <div class="doc-popup-body" id="modalDocBody"></div>
    </div>
</div>

<!-- Client-side Document Modal Trigger Logic -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('documentViewModal');
    const overlay = modal.querySelector('.doc-popup-overlay');
    const closeBtn = document.getElementById('closeModalBtn');
    const modalTitle = document.getElementById('modalDocTitle');
    const modalBody = document.getElementById('modalDocBody');
    const triggers = document.querySelectorAll('.view-doc-trigger');

    function extensionOf(url) {
        // The filename lives in the ?path= query parameter — the URL's
        // own path is always ".../documents/file" with no extension at
        // all. Stripping the query string first therefore threw away the
        // only part that could identify the file type, so every document
        // (including JPGs and PNGs) fell through to the PDF/iframe
        // branch and the image-specific handling never ran.
        try {
            const queryString = url.split('?')[1] || '';
            const storedPath = new URLSearchParams(queryString).get('path') || url;
            const clean = storedPath.split('#')[0];
            return clean.includes('.') ? clean.split('.').pop().toLowerCase() : '';
        } catch (err) {
            return '';
        }
    }

    const IMAGE_EXTS = new Set(['jpg', 'jpeg', 'png', 'webp']);

    function buildFallback(url) {
        const wrap = document.createElement('div');
        wrap.className = 'doc-fallback';
        wrap.innerHTML = `
            <i class="fa-solid fa-file-circle-question doc-fallback-icon"></i>
            <p class="doc-fallback-text">Preview isn't available in this browser.</p>
            <a href="${url}" target="_blank" rel="noopener" class="doc-fallback-btn">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Document
            </a>
        `;
        return wrap;
    }

    triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const title = trigger.getAttribute('data-doc-title');
            const url = trigger.getAttribute('data-doc-url');
            const ext = extensionOf(url);

            modalTitle.textContent = title;
            modalBody.innerHTML = '';

            // Always-available escape hatch, shown alongside the preview.
            const openLink = document.createElement('a');
            openLink.href = url;
            openLink.target = '_blank';
            openLink.rel = 'noopener';
            openLink.className = 'doc-open-new-tab';
            openLink.innerHTML = '<i class="fa-solid fa-arrow-up-right-from-square"></i> Open in new tab';

            if (IMAGE_EXTS.has(ext)) {
                const img = document.createElement('img');
                img.id = 'modalDocFrame';
                img.className = 'doc-preview-img';
                img.alt = title;

                // Images either load or they don't — onerror is reliable here.
                img.onerror = () => {
                    modalBody.innerHTML = '';
                    modalBody.appendChild(buildFallback(url));
                };
                img.src = url;
                modalBody.appendChild(img);
                modalBody.appendChild(openLink);
            } else {
                // PDFs (and anything else) — iframe as the primary attempt.
                // Some browsers (mobile Safari quirks, in-app webviews with
                // no PDF engine, locked-down corporate browsers) either
                // fail silently or render a blank/broken frame with no
                // error event at all, so we can't rely purely on onerror
                // here. A short timeout checks whether the iframe actually
                // produced usable content; if not, swap to the fallback.
                const iframe = document.createElement('iframe');
                iframe.id = 'modalDocFrame';
                iframe.className = 'doc-preview-frame';
                iframe.setAttribute('frameborder', '0');

                let settled = false;

                iframe.onerror = () => {
                    if (settled) return;
                    settled = true;
                    modalBody.innerHTML = '';
                    modalBody.appendChild(buildFallback(url));
                };

                iframe.onload = () => {
                    settled = true;
                };

                iframe.src = url;
                modalBody.appendChild(iframe);
                modalBody.appendChild(openLink);

                // Fallback safety net: if neither onload nor onerror fired
                // within 4s (some browsers just hang on unsupported types),
                // assume it failed and offer the direct-open fallback.
                setTimeout(() => {
                    if (!settled) {
                        settled = true;
                        modalBody.innerHTML = '';
                        modalBody.appendChild(buildFallback(url));
                    }
                }, 4000);
            }

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        });
    });

    const closeModal = () => {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(() => {
            modalBody.innerHTML = '';
        }, 300);
    };

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('active')) {
            closeModal();
        }
    });
});
</script>