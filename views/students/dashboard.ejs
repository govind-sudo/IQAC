<% layout("layout/studentsBoilerPlate") %>

<%
const studentInfo = student || {};
const isIndian = (studentInfo.nationality || '').toLowerCase() === 'indian';

const studentName =
    studentInfo.fullName ||
    [studentInfo.firstName, studentInfo.lastName].filter(Boolean).join(" ");

const initials = studentName
    ? studentName.split(" ").map(n => n[0]).slice(0,2).join("").toUpperCase()
    : "S";

const greeting =
    new Date().getHours() < 12
        ? "Good Morning"
        : new Date().getHours() < 17
        ? "Good Afternoon"
        : "Good Evening";

function filled(value) {
    return value !== undefined && value !== null && value !== "";
}
const checkFields = (arr) => arr.filter(filled).length;

// 1. Personal Info
const personalFields = isIndian
    ? [studentInfo.firstName, studentInfo.lastName, studentInfo.gender, studentInfo.dob, studentInfo.bloodGroup, studentInfo.category, studentInfo.email, studentInfo.phone]
    : [studentInfo.firstName, studentInfo.lastName, studentInfo.gender, studentInfo.dob, studentInfo.bloodGroup, studentInfo.email, studentInfo.phone];
const personalPct = Math.round((checkFields(personalFields) / personalFields.length) * 100);

// 2. Academic Info
const academicFields = [
    studentInfo.faculty, studentInfo.institute, studentInfo.course,
    studentInfo.branch, studentInfo.admissionYear
];
const academicPct = Math.round((checkFields(academicFields) / academicFields.length) * 100);

// 3. Contact & Address — FIXED: address1 (real schema field), not addressLine
const contactFields = [
    studentInfo.presentAddress?.address1, studentInfo.presentAddress?.city, studentInfo.presentAddress?.state,
    studentInfo.permanentAddress?.address1, studentInfo.permanentAddress?.city
];
const contactPct = Math.round((checkFields(contactFields) / contactFields.length) * 100);

// 4. Documents — FIXED: real schema paths, real field names, nationality-aware,
// checked by "does a path exist" not "does the string equal 'uploaded'"
const indianDocChecks = [
    !!studentInfo.documents?.aadhaarProof,
    !!studentInfo.education?.tenth?.marksheet,
    !!(studentInfo.education?.twelfth?.marksheet || studentInfo.education?.diploma?.marksheet),
    !!studentInfo.documents?.leavingCertificate,
    !!studentInfo.documents?.abcIdProof,
];
const intlDocChecks = [
    !!studentInfo.documents?.passportUpload,
    !!studentInfo.documents?.aoLevelCertificate,
    !!studentInfo.documents?.puAdmissionLetter,
];
const docChecks = isIndian ? indianDocChecks : intlDocChecks;
const documentsPct = Math.round((docChecks.filter(Boolean).length / docChecks.length) * 100);

// 5. Emergency & Parents
const legacyFields = [
    studentInfo.father?.name, studentInfo.mother?.name,
    studentInfo.emergencyContact?.name, studentInfo.emergencyContact?.phone
];
const emergencyPct = Math.round((checkFields(legacyFields) / legacyFields.length) * 100);

const sectionsList = [
    { label: "Personal Information", pct: personalPct },
    { label: "Academic Information", pct: academicPct },
    { label: "Contact & Address", pct: contactPct },
    { label: "Documents", pct: documentsPct },
    { label: "Emergency & Parents", pct: emergencyPct }
];

const profilePercent = Math.round(
    (personalPct + academicPct + contactPct + documentsPct + emergencyPct) / 5
);
%>

<div class="dashboard">

    <!-- ================= HEADER ================= -->
<!-- ================= HEADER ================= -->
<section class="dashboard-header">

    <!-- LEFT COLUMN: Campus ID Card Layout -->
<div class="header-left">
    <div class="campus-card">
        <div class="campus-card-top">
            <!-- Group container isolates avatar and details away from badge text -->
            <div class="campus-identity-group">
                <div class="campus-avatar">
                    <%= initials %>
                </div>
                <div class="campus-details">
                    <h3><%= studentName %></h3>
                    <p><%= studentInfo.course || "B.Tech" %> · <%= studentInfo.branch || "CSE" %> · <%= studentInfo.admissionYear || "2026" %></p>
                </div>
            </div>
            <span class="campus-badge-text">CAMPUS ID</span>
        </div>
        
        <div class="campus-barcode-container">
            <div class="barcode-lines"></div>
            <div class="barcode-number"><%= studentInfo.ugNumber || "24UG123456" %></div>
        </div>
    </div>
</div>

    <!-- RIGHT COLUMN: Metrics Row & Completion Tracker Panel -->
    <div class="header-right">
        
        <!-- Top Container: Horizontal Metrics Panel Row -->
        <div class="mini-info">
            <div class="mini-item">
                <div class="mini-icon-wrapper mini-blue">
                    <i class="fa-regular fa-id-card"></i>
                </div>
                <div class="mini-content">
                    <span>UG Number</span>
                    <strong><%= studentInfo.ugNumber || "-" %></strong>
                </div>
            </div>

            <div class="mini-divider"></div>

            <div class="mini-item">
                <div class="mini-icon-wrapper mini-indigo">
                    <i class="fa-regular fa-calendar"></i>
                </div>
                <div class="mini-content">
                    <span>Admission Year</span>
                    <strong><%= studentInfo.admissionYear || "-" %></strong>
                </div>
            </div>

            <div class="mini-divider"></div>

            <div class="mini-item">
                <% 
                    const isPending = (studentInfo.profileStatus || "").toLowerCase() === "pending" || (studentInfo.profileStatus || "").toLowerCase() === "incomplete";
                    const statusClass = isPending ? "status-dot-pending" : "status-dot-active";
                    const labelClass = isPending ? "status-label-pending" : "status-label-active";
                %>
                <div class="mini-icon-wrapper <%= statusClass %>">
                    <span class="status-inner-dot"></span>
                </div>
                <div class="mini-content">
                    <span>Profile Status</span>
                    <strong class="<%= labelClass %>"><%= studentInfo.profileStatus || "Active" %></strong>
                </div>
            </div>
        </div>

        <!-- Bottom Container: Linear Progress Tracker Panel -->
        <div class="completion-card">
            <div class="completion-icon">
                <i class="fa-regular fa-clipboard"></i>
            </div>
            <div class="completion-body">
                <div class="completion-text-row">
                    <h3>Complete your profile</h3>
                    <i class="fa-solid fa-chevron-right arrow-link"></i>
                </div>
                <p>Your profile is <%= profilePercent || 0 %>% complete</p>
                <div class="progress-container">
                    <div class="progress-bar-wrapper">
                        <span class="progress-fill" style="width: <%= profilePercent || 0 %>%"></span>
                    </div>
                    <strong class="progress-pct-text"><%= profilePercent || 0 %>%</strong>
                </div>
            </div>
        </div>

    </div>

</section>


    <!-- ================= MAIN GRID ================= -->

    <section class="dashboard-grid">

        <!-- LEFT COLUMN -->

        <div class="left-column">

<div class="card personal-card">

    <div class="card-header">

        <div class="title">

            <div class="title-icon">
                <i class="fa-solid fa-user"></i>
            </div>

            <h2>Personal Information</h2>

        </div>

    </div>

    <div class="card-body personal-body">

        <div class="personal-avatar">

            <div class="avatar-circle">
                <%= initials %>
            </div>

        </div>


        <div class="personal-grid">

            <div class="info-item">
                <i class="fa-solid fa-user"></i>

                <div>
                    <span>Full Name : </span>
                    <strong><%= studentName || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-solid fa-flag"></i>

                <div>
                    <span>Nationality : </span>
                    <strong><%= studentInfo.nationality || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-regular fa-calendar"></i>

                <div>
                    <span>Date of Birth : </span>

                    <strong>
                        <%= studentInfo.dob
                        ? new Date(studentInfo.dob).toLocaleDateString("en-GB",{
                            day:"2-digit",
                            month:"short",
                            year:"numeric"
                        })
                        : "-" %>
                    </strong>

                </div>
            </div>

            <div class="info-item">
                <i class="fa-solid fa-shield-halved"></i>

                <div>
                    <span>Category : </span>
                    <strong><%= studentInfo.category || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-solid fa-mars"></i>

                <div>
                    <span>Gender : </span>
                    <strong><%= studentInfo.gender || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-regular fa-envelope"></i>

                <div>
                    <span>Email : </span>
                    <strong><%= studentInfo.email || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-solid fa-droplet"></i>

                <div>
                    <span>Blood Group : </span>
                    <strong><%= studentInfo.bloodGroup || "-" %></strong>
                </div>
            </div>

            <div class="info-item">
                <i class="fa-solid fa-phone"></i>

                <div>
                    <span>Phone : </span>
                    <strong><%= studentInfo.phone || "-" %></strong>
                </div>
            </div>

        </div>

    </div>

</div>

