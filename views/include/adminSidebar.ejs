<button class="menu-btn" id="menuToggleBtn" aria-label="Toggle Navigation Menu">
    <i class="fa-solid fa-bars"></i>
</button>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="adminSidebar">

    <!-- ==========================================
         Logo Header Group
         ========================================== -->
    <div class="sidebar-top">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="logo-text">
                <h2>IQAC</h2>
                <p>Internal Quality</p>
                <p>Assurance Administration</p>
            </div>
        </div>

        <!-- ==========================================
             Navigation Panel
             ========================================== -->
        <nav class="sidebar-nav">
            <ul>
                <!-- Dashboard (Admin & Subadmin) -->
                <li class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
                    <a href="/admin/dashboard">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <!-- Students (Admin & Subadmin) -->
                <li class="<%= currentPage === 'students' ? 'active' : '' %>">
                    <a href="/admin/students">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Students</span>
                    </a>
                </li>

                <!-- Download Documents (Admin & Subadmin) -->
                <li class="<%= currentPage === 'documents' ? 'active' : '' %>">
                    <a href="/admin/documents">
                        <i class="fa-solid fa-file-zipper"></i>
                        <span>Download Documents</span>
                    </a>
                </li>

                <!-- Sub Admins (Admin & Subadmin) -->
                <li class="<%= currentPage === 'subadmins' ? 'active' : '' %>">
                    <a href="/admin/subadmins">
                        <i class="fa-solid fa-user-shield"></i>
                        <span>Sub Admins</span>
                    </a>
                </li>

                <!-- All Admins (Admin & Subadmin) -->
                <li class="<%= currentPage === 'allAdmins' ? 'active' : '' %>">
                    <a href="/admin/allAdmins">
                        <i class="fa-solid fa-users-gear"></i>
                        <span>Admins</span>
                    </a>
                </li>

                <!-- Profile (Admin & Subadmin) -->
                <li class="<%= currentPage === 'profile' ? 'active' : '' %>">
                    <a href="/admin/profile">
                        <i class="fa-regular fa-user"></i>
                        <span>My Profile</span>
                    </a>
                </li>

                <!-- Root Admin Only Section -->
                <% 
                    // Safely resolve the logged-in user object across different middleware naming conventions
                    const loggedInUser = typeof currentUser !== 'undefined' ? currentUser : (typeof user !== 'undefined' ? user : (typeof admin !== 'undefined' && !Array.isArray(admin) ? admin : null));
                %>

                <% if (loggedInUser && (loggedInUser.role === 'admin' || loggedInUser.role === 'ADMIN')) { %>
                    <!-- Add Admin -->
                    <li class="<%= currentPage === 'addAdmin' ? 'active' : '' %>">
                        <a href="/admin/add">
                            <i class="fa-solid fa-user-plus"></i>
                            <span>Add Admin</span>
                        </a>
                    </li>

                    <!-- Edit Profile / Settings -->
                    <li class="<%= currentPage === 'editProfile' ? 'active' : '' %>">
                        <a href="/admin/<%= loggedInUser._id %>/edit">
                            <i class="fa-solid fa-gear"></i>
                            <span>Edit Profile</span>
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>

    <!-- ==========================================
         Bottom Action & Support Section
         ========================================== -->
    <div class="sidebar-bottom">
        <div class="help-card">
            <div class="help-icon">
                <i class="fa-solid fa-headset"></i>
            </div>
            <div class="help-content">
                <h4>Need Help?</h4>
                <p>Contact the System Administrator for technical assistance.</p>
                <a href="/admin/help" class="support-link">
                    Contact Support
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <a href="/logout" class="logout-link">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Logout</span>
        </a>
    </div>
</aside>

<!-- External Client JS Handler -->
<script src="/js/adminSidebar.js"></script>