# ---------- AI provider (fallback name-verification only) ----------
# Which provider services/AIService.js should load. Currently supported:
#   gemini
# (openai / anthropic / azure can be added later without code changes
# to documentVerifier.js — see providers/README or AIService.js)
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- PaddleOCR (primary OCR engine) ----------
# Path/command to the Python interpreter that has paddleocr installed.
# Linux/macOS (after `python3 -m venv .venv && source .venv/bin/activate`):
#   PADDLE_OCR_PYTHON_BIN=python3
# Windows (after `py -m venv .venv` and activating it):
#   PADDLE_OCR_PYTHON_BIN=.venv\Scripts\python.exe
PADDLE_OCR_PYTHON_BIN=python3

# Only needed on Windows, where Poppler isn't normally on PATH. Point
# this at the "bin" folder inside the Poppler release you downloaded
# (the folder containing pdftoppm.exe / pdfinfo.exe). Leave blank on
# Linux — apt's poppler-utils package puts the binaries on PATH already.
#   POPPLER_PATH=C:\poppler-24.08.0\Library\bin
POPPLER_PATH=
