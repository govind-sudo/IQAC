<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #5263ab;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            padding: 2rem 1.5rem;
        }

        .not-found-wrapper {
            max-width: 850px;
            width: 100%;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Large Image Container */
        .image-container {
            width: 100%;
            max-width: 720px;
            margin-bottom: 2rem;
            border-radius: 20px;
            overflow: hidden;
        }

        .image-container img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
        }

        /* Action Details & Buttons */
        .not-found-message {
            font-size: 1.25rem;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: 2rem;
        }

        .btn-home {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 2.25rem;
            background-color: #ffffff;
            color: #5c67a3;
            font-size: 1.05rem;
            font-weight: 700;
            border-radius: 50px;
            text-decoration: none;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .btn-home:hover {
            transform: translateY(-3px);
            background-color: #f8fafc;
        }

        @media (max-width: 640px) {
            .image-container {
                max-width: 100%;
            }
            .not-found-message {
                font-size: 1.05rem;
            }
        }
    </style>
</head>
<body>

    <div class="not-found-wrapper">
        
        <!-- Larger 404 Illustration Image -->
        <div class="image-container">
            <img src="/4012cdc2cf44b21bfcb51ccf5c09c42e.jpg" alt="404 Page Not Found">
        </div>

        <!-- Text & Navigation Action -->
        <p class="not-found-message">
            Oops! The page you are looking for doesn't exist or has been moved.
        </p>

        <a href="/login" class="btn-home">
            <i class="fa-solid fa-house"></i>
            Back to Dashboard
        </a>

    </div>

</body>
</html>