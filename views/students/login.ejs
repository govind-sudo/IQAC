<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IQAC Portal Login</title>
  <link rel="stylesheet" href="/css/students/studentsLogin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
</head>
<body>

  <div class="page-container">
    <!-- Top Header / Brand -->
    <header class="brand-header">
      <div class="brand-logo">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>IQAC PORTAL</span>
      </div>
    </header>

    <!-- Main Content Grid -->
    <main class="main-content">
      
      <!-- Left Hero Section -->
      <section class="hero-section">
        <div class="hero-title-group">
          <p class="hero-subtitle">Welcome to</p>
          <h1 class="hero-title">IQAC <span>Portal</span></h1>
          <div class="hero-divider"></div>
          <p class="hero-tagline">Empowering Quality. Enhancing Education.</p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Secure Access</h3>
            <p>Your data is protected with enterprise-grade security.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-chart-simple"></i></div>
            <h3>Smart Insights</h3>
            <p>Access important data and insights in one place.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-user-group"></i></div>
            <h3>Student First</h3>
            <p>Designed to simplify academic processes for students.</p>
          </div>
        </div>

        <div class="hero-footer-note">
          <i class="fa-solid fa-shield-cat"></i>
          <span>Official portal for students and administrators of our institution.</span>
        </div>
      </section>

      <!-- Right Login Card Section -->
      <section class="login-wrapper">
        <div class="login-card">
          <div class="card-icon-header">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <h2 class="login-title">Login to Your Account</h2>
          <p class="login-subtext">Access your IQAC portal account</p>

          <form id="loginForm" action="/login" method="POST" autocomplete="off">
            <div class="role-select" role="radiogroup" aria-label="Login as">
              <label class="role-option">
                <input type="radio" name="role" value="admin" />
                <span class="role-pill"><i class="fa-solid fa-shield"></i> Admin</span>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="student" checked />
                <span class="role-pill"><i class="fa-solid fa-user"></i> Student</span>
              </label>
            </div>

            <!-- STUDENT FIELDS -->
            <div id="studentFields" class="role-fields">
              <label for="ugNumber" class="field-label">UG Number</label>
              <div class="input-with-icon">
                <i class="fa-regular fa-user"></i>
                <input
                  type="text"
                  id="ugNumber"
                  name="ugNumber"
                  class="mis-input"
                  placeholder="Enter your UG Number"
                  autocomplete="off"
                />
              </div>

              <!-- Google sign-in section -->
              <div id="googleSection" class="google-section">
                <button type="button" id="googleSignInBtn" class="google-btn">
                  <i class="fa-solid fa-arrow-right"></i>
                  <span>Continue</span>
                </button>
              </div>
            </div>

            <!-- ADMIN FIELDS -->
            <div id="adminFields" class="role-fields" hidden>
              <label for="misCode" class="field-label">MIS Code</label>
              <div class="input-with-icon">
                <i class="fa-regular fa-id-card"></i>
                <input
                  type="text"
                  id="misCode"
                  name="misCode"
                  class="mis-input"
                  placeholder="Enter your MIS Code"
                  autocomplete="off"
                />
              </div>

              <!-- Google Sign In -->
              <div id="adminGoogleSection" class="google-section">
                <button type="button" id="adminGoogleSignInBtn" class="google-btn">
                  <i class="fa-solid fa-arrow-right"></i>
                  <span>Continue</span>
                </button>
                <p class="google-note">
                  Kindly login using your <strong>institute email ID</strong><br />
                  (<strong>@paruluniversity.ac.in</strong>)
                </p>
              </div>
            </div>
          </form>

          <div class="divider"><span>or</span></div>

          <a href="/register" id="registerLink" class="register-link">New Student? <span>Register here</span></a>
        </div>
      </section>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/studentsLogin.js"></script>
  <% if (error) { %>
  <script>
  Swal.fire({
      icon: "error",
      title: "Login Failed",
      text: "<%= error %>",
      confirmButtonText: "Try Again",
      confirmButtonColor: "#5c7cf8",
      background: "#1e293b",
      color: "#ffffff",
      backdrop: `rgba(15, 23, 42, 0.6) blur(4px)`,
      showClass: { popup: "animate__animated animate__zoomIn" },
      hideClass: { popup: "animate__animated animate__zoomOut" }
  });
  </script>
  <% } %>
</body>
</html>