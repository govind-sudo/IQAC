<% layout('layout/adminBoilerPlate') %>

<style>
    /* Styling for the disabled Save Changes button */
    .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        filter: grayscale(20%);
        box-shadow: none;
    }
</style>

<div class="form-page-container">
    <div class="form-header">
        <a href="/admin/subadmins" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to Sub-Admins
        </a>
        <h1>Edit Sub-Admin</h1>
        <p>Update profile details and account status for <%= subadmin.fullName %>.</p>
    </div>

    <div class="card form-card">

        <!-- Error Popup Banner -->
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert-popup error">
                <div class="alert-icon">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </div>
                <div class="alert-content">
                    <strong>Action Failed</strong>
                    <p><%= errorMessage %></p>
                </div>
                <button type="button" class="close-alert-btn" onclick="this.parentElement.remove();">&times;</button>
            </div>
        <% } %>

        <form action="/admin/subadmins/<%= subadmin._id %>?_method=PUT" method="POST" class="subadmin-form" id="editSubadminForm">
            
            <div class="form-row">
                <!-- Full Name -->
                <div class="form-group">
                    <label for="fullName">Full Name <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="fullName" 
                        name="fullName" 
                        value="<%= typeof formData !== 'undefined' && formData.fullName ? formData.fullName : subadmin.fullName %>"
                        placeholder="e.g., Jane Doe" 
                        required 
                        autocomplete="off"
                    />
                </div>

                <!-- MIS Code -->
                <div class="form-group">
                    <label for="misCode">MIS Code <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="misCode" 
                        name="misCode" 
                        value="<%= typeof formData !== 'undefined' && formData.misCode ? formData.misCode : subadmin.misCode %>"
                        placeholder="e.g., MIS10293" 
                        required 
                        style="text-transform: uppercase;"
                        autocomplete="off"
                    />
                </div>
            </div>

            <div class="form-row">
                <!-- Email -->
                <div class="form-group">
                    <label for="email">Email Address <span class="required">*</span></label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : subadmin.email %>"
                        placeholder="e.g., subadmin@university.ac.in" 
                        required 
                        autocomplete="off"
                    />
                </div>

                <!-- Phone -->
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        value="<%= typeof formData !== 'undefined' && formData.phone !== undefined ? formData.phone : (subadmin.phone || '') %>"
                        placeholder="e.g., 9876543210" 
                        autocomplete="off"
                    />
                </div>
            </div>

            <div class="form-row">
                <!-- Active Status -->
                <div class="form-group checkbox-group">
                    <label class="switch-label">
                        <input 
                            type="checkbox" 
                            name="isActive" 
                            id="isActive"
                            value="true" 
                            <%= (typeof formData !== 'undefined' ? (formData.isActive === 'true' || formData.isActive === true || formData.isActive === 'on') : subadmin.isActive) ? 'checked' : '' %> 
                        />
                        <span class="label-text">Account Active</span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <a href="/admin/subadmins" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary" id="saveBtn" disabled>
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Form Change Detector Script -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("editSubadminForm");
        const saveBtn = document.getElementById("saveBtn");
        
        if (!form || !saveBtn) return;

        // Capture initial values of form inputs
        const initialValues = {};
        const inputs = form.querySelectorAll("input");

        inputs.forEach(input => {
            if (input.type === "checkbox") {
                initialValues[input.name] = input.checked;
            } else {
                initialValues[input.name] = input.value.trim();
            }
        });

        // Check if any current input value differs from the initial state
        const checkForChanges = () => {
            let isChanged = false;

            inputs.forEach(input => {
                if (input.type === "checkbox") {
                    if (input.checked !== initialValues[input.name]) {
                        isChanged = true;
                    }
                } else {
                    if (input.value.trim() !== initialValues[input.name]) {
                        isChanged = true;
                    }
                }
            });

            saveBtn.disabled = !isChanged;
        };

        // Attach listeners for text changes and checkbox toggles
        form.addEventListener("input", checkForChanges);
        form.addEventListener("change", checkForChanges);
    });
</script>
    <script>
        // Phone: 10 digits, no country code. Mirrors the server-side
        // normaliser in adminController.js so browser autofill can't
        // silently slip a "+91 " in without the user noticing.
        (function () {
            var phoneInput = document.getElementById("phone");
            if (!phoneInput) return;
            phoneInput.setAttribute("inputmode", "numeric");
            phoneInput.setAttribute("maxlength", "10");
            phoneInput.setAttribute("pattern", "[0-9]{10}");
            phoneInput.setAttribute("title", "Enter a 10-digit number without the country code");
            function clean() {
                var digits = phoneInput.value.replace(/\D/g, "");
                if (digits.length === 12 && digits.indexOf("91") === 0) digits = digits.slice(2);
                else if (digits.length === 11 && digits.indexOf("0") === 0) digits = digits.slice(1);
                if (digits.length > 10) digits = digits.slice(-10);
                if (phoneInput.value !== digits) phoneInput.value = digits;
            }
            phoneInput.addEventListener("input", clean);
            phoneInput.addEventListener("blur", clean);
            clean();
        })();
    </script>
