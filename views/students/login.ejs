<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IQAC Portal Login</title>
  <link rel="stylesheet" href="/css/students/studentsLogin.css" />
</head>
<body>

  <div class="login-wrapper">
    <div class="login-card">
      <h1 class="login-title">IQAC Portal Login</h1>

      <form id="loginForm" action="/login" method="POST" autocomplete="off">
        <div class="role-select" role="radiogroup" aria-label="Login as">
          <label class="role-option">
            <input type="radio" name="role" value="admin" />
            <span class="role-pill">Admin</span>
          </label>
          <label class="role-option">
            <input type="radio" name="role" value="student" checked />
            <span class="role-pill">Student</span>
          </label>
        </div>

        <!-- STUDENT FIELDS -->
        <div id="studentFields" class="role-fields">
          <label for="ugNumber" class="field-label">UG Number</label>
          <input
            type="text"
            id="ugNumber"
            name="ugNumber"
            class="mis-input"
            placeholder="Enter your UG Number"
            autocomplete="off"
          />

          <!-- Google sign-in section, hidden until user types -->
          <div id="googleSection" class="google-section">
            <button type="button" id="googleSignInBtn" class="google-btn">
              <svg class="google-icon" viewBox="0 0 48 48" width="18" height="18">
                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12
                  c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24
                  c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039
                  l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36
                  c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571
                  c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24
                  C44,22.659,43.862,21.35,43.611,20.083z"/>
              </svg>
              <span>Sign in with Google</span>
            </button>

            
          </div>
        </div>

        <!-- ADMIN FIELDS -->
       <!-- ADMIN FIELDS -->
<div id="adminFields" class="role-fields" hidden>

  <label for="misCode" class="field-label">MIS Code</label>

  <input
    type="text"
    id="misCode"
    name="misCode"
    class="mis-input"
    placeholder="Enter your MIS Code"
    autocomplete="off"
  />

  <!-- Google Sign In -->
  <div id="adminGoogleSection" class="google-section">

    <button
      type="button"
      id="adminGoogleSignInBtn"
      class="google-btn"
    >

      <svg class="google-icon" viewBox="0 0 48 48" width="18" height="18">
        <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12
                  c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24
                  c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
        <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039
                  l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
        <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36
                  c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
        <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571
                  c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24
                  C44,22.659,43.862,21.35,43.611,20.083z"/>
      </svg>

      <span>Sign in with Google</span>

    </button>

    <p class="google-note">
      Kindly login using your
      <strong>institute email ID</strong><br />
      (<strong>@paruluniversity.ac.in</strong>)
    </p>

  </div>

</div>
      </form>

      <a href="/register" id="registerLink" class="register-link">New Student? Register here</a>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/studentsLogin.js"></script>
 <% if (error) { %>
<script>
Swal.fire({
    icon: "error",
    title: "Login Failed",
    text: "<%= error %>",
    confirmButtonText: "Try Again",
    confirmButtonColor: "#2f60a0",
    background: "#ffffff",
    color: "#17332E",
    backdrop: `
        rgba(31,66,111,0.35)
        blur(4px)
    `,
    showClass: {
        popup: "animate__animated animate__zoomIn"
    },
    hideClass: {
        popup: "animate__animated animate__zoomOut"
    }
});
</script>
<% } %>
</body>
</html>
